 use super::*;
+
+#[cfg(test)]
+thread_local! {
+    pub(super) static REVERSE_REACHABILITY_SEARCH_COUNT: std::cell::Cell<usize> = const {
+        std::cell::Cell::new(0)
+    };
+}
+
+// One immutable finder invocation owns this index. Cached results use one bit
+// per graph node rather than retaining a cloned String set for every merge.
+pub(super) struct ReverseReachabilityCache {
+    indices: HashMap<String, usize>,
+    predecessors: Vec<Vec<usize>>,
+    reached_by_target: HashMap<String, Vec<u64>>,
+}
+
+pub(super) struct ReverseReachableSet<'a> {
+    indices: &'a HashMap<String, usize>,
+    bits: &'a [u64],
+    target: &'a str,
+}
+
+impl ReverseReachableSet<'_> {
+    pub(super) fn contains(&self, name: &str) -> bool {
+        // The original traversal includes its start even if it has no graph
+        // entry, for example a missing or external label.
+        name == self.target
+            || self.indices.get(name).is_some_and(|&index| {
+                self.bits[index / 64] & (1u64 << (index % 64)) != 0
+            })
+    }
+}
+
+impl ReverseReachabilityCache {
+    pub(super) fn new(blocks: &[BodyBlock]) -> Self {
+        let predecessors = predecessors(blocks);
+        let mut indices = HashMap::new();
+        for block in blocks {
+            let index = indices.len();
+            indices.entry(block.name.clone()).or_insert(index);
+        }
+        // Keep external destinations too: reverse queries starting there must
+        // still find their incoming edges from known blocks.
+        let mut external = predecessors
+            .keys()
+            .filter(|name| !indices.contains_key(*name))
+            .cloned()
+            .collect::<Vec<_>>();
+        external.sort();
+        for name in external {
+            let index = indices.len();
+            indices.insert(name, index);
+        }
+        let mut indexed_predecessors = vec![Vec::new(); indices.len()];
+        for (target, sources) in predecessors {
+            indexed_predecessors[indices[&target]] = sources
+                .iter()
+                .map(|source| indices[source])
+                .collect();
+        }
+        Self {
+            indices,
+            predecessors: indexed_predecessors,
+            reached_by_target: HashMap::new(),
+        }
+    }
+
+    pub(super) fn reachable<'a>(&'a mut self, target: &'a str) -> ReverseReachableSet<'a> {
+        if !self.reached_by_target.contains_key(target) {
+            #[cfg(test)]
+            REVERSE_REACHABILITY_SEARCH_COUNT.with(|count| count.set(count.get() + 1));
+            let mut bits = vec![0u64; self.predecessors.len().div_ceil(64)];
+            let mut stack = self.indices.get(target).copied().into_iter().collect::<Vec<_>>();
+            while let Some(node) = stack.pop() {
+                let word = node / 64;
+                let bit = 1u64 << (node % 64);
+                if bits[word] & bit != 0 {
+                    continue;
+                }
+                bits[word] |= bit;
+                stack.extend(self.predecessors[node].iter().copied());
+            }
+            self.reached_by_target.insert(target.to_string(), bits);
+        }
+        ReverseReachableSet {
+            indices: &self.indices,
+            bits: &self.reached_by_target[target],
+            target,
+        }
+    }
+}
 
