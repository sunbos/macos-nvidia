@@ -0,0 +1,199 @@
+//! Preserve effects on the source memory access, never every temporary emitted
+//! while lowering that instruction. Unsupported volatile shapes fail closed.
+use super::*;
+
+impl Emitter {
+    fn begin_volatile_access(
+        &mut self,
+        op: Op,
+        pointer: &TypedValue,
+        value_type: &LlType,
+        align: Option<u64>,
+        instructions: &mut Vec<Instruction>,
+    ) -> Result<(), String> {
+        if self.volatile_source_access.is_some()
+            || pointer.ty != LlType::Ptr(3)
+            || !matches!(
+                self.resolve_type(value_type)?,
+                LlType::Float | LlType::Int(32)
+            )
+        {
+            return Err(
+                "native emitter: volatile access requires one scalar 32-bit Workgroup access"
+                    .into(),
+            );
+        }
+        let target = if let LlValue::Local(name) = &pointer.value {
+            if self.selected_access_trees.contains_key(name)
+                || self.selected_load_pointers.contains_key(name)
+                || self.selected_pointers.contains_key(name)
+                || self.vector_word_pointers.contains_key(name)
+                || self.workgroup_padding_byte_pointers.contains_key(name)
+            {
+                return Err(
+                    "native emitter: volatile access has no single proven memory target".into(),
+                );
+            }
+            if let Some(raw) = self.raw_offsets.get(name) {
+                if raw.unmodelable
+                    || self.raw_access_storage(raw)? != StorageClass::Workgroup
+                    || !self.raw_word_access_can_use_word_index(raw, 0, align)
+                {
+                    return Err(
+                        "native emitter: volatile raw access requires one aligned Workgroup word"
+                            .into(),
+                    );
+                }
+                // A modeled raw GEP may also have a dummy logical pointer;
+                // ordinary emission uses this proven raw model before that tag.
+                Some(VolatileAccessTarget::RawRoot(raw.root.clone()))
+            } else {
+                if self.unmodeled_pointers.contains(name) {
+                    return Err(
+                        "native emitter: volatile access has an unmodeled pointer placeholder"
+                            .into(),
+                    );
+                }
+                None
+            }
+        } else {
+            None
+        };
+        let target = match target {
+            Some(target) => target,
+            None => {
+                if self.pointer_storage_for(&pointer.value, 3)? != StorageClass::Workgroup
+                    || self.pointer_pointee_for_value(&pointer.value)?.as_ref()
+                        != Some(&self.resolve_type(value_type)?)
+                {
+                    return Err("native emitter: volatile direct access requires an exact Workgroup pointee".into());
+                }
+                VolatileAccessTarget::Direct(self.value_id_in(
+                    &pointer.value,
+                    &pointer.ty,
+                    instructions,
+                )?)
+            }
+        };
+        self.volatile_source_access = Some(VolatileSourceAccess {
+            op,
+            target,
+            hits: 0,
+        });
+        Ok(())
+    }
+
+    fn finish_volatile_access(&mut self, emitted: Result<(), String>) -> Result<(), String> {
+        let access = self.volatile_source_access.take();
+        emitted?;
+        if access.is_none_or(|access| access.hits != 1) {
+            return Err(
+                "native emitter: volatile source did not emit exactly one matching memory access"
+                    .into(),
+            );
+        }
+        Ok(())
+    }
+
+    pub(in crate::native::emitter) fn emit_volatile_load(
+        &mut self,
+        name: String,
+        load: LlLoad,
+        result_type: LlType,
+        instructions: &mut Vec<Instruction>,
+    ) -> Result<(), String> {
+        self.begin_volatile_access(Op::Load, &load.ptr, &result_type, load.align, instructions)?;
+        let emitted = self.emit_load_resolved(name, load, result_type, instructions);
+        self.finish_volatile_access(emitted)
+    }
+
+    pub(in crate::native::emitter) fn emit_volatile_store(
+        &mut self,
+        value: TypedValue,
+        pointer: TypedValue,
+        align: Option<u64>,
+        instructions: &mut Vec<Instruction>,
+    ) -> Result<(), String> {
+        self.begin_volatile_access(Op::Store, &pointer, &value.ty, align, instructions)?;
+        let emitted = self.emit_store_resolved(value, pointer, align, instructions);
+        self.finish_volatile_access(emitted)
+    }
+
+    pub(in crate::native::emitter) fn mark_source_volatile_access(
+        &mut self,
+        op: Op,
+        pointer: Word,
+        raw_root: Option<&str>,
+        operands: &mut Vec<Operand>,
+    ) {
+        let Some(access) = &mut self.volatile_source_access else {
+            return;
+        };
+        let matches = match &access.target {
+            VolatileAccessTarget::Direct(expected) => raw_root.is_none() && pointer == *expected,
+            VolatileAccessTarget::RawRoot(expected) => raw_root == Some(expected.as_str()),
+        };
+        if access.op == op && matches {
+            // Admission restricts this to Workgroup, so no PhysicalStorageBuffer
+            // alignment operand needs merging here.
+            operands.push(Operand::MemoryAccess(MemoryAccess::VOLATILE));
+            access.hits += 1;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn source_volatile_error_and_missing_access_clear_the_scope() {
+        let module = LlModule::parse("define void @k() {\nentry:\n ret void\n}").unwrap();
+        let mut emitter = Emitter::new(module);
+        for error in [Some("lowering failed"), None] {
+            emitter.volatile_source_access = Some(VolatileSourceAccess {
+                op: Op::Load,
+                target: VolatileAccessTarget::Direct(42),
+                hits: 0,
+            });
+            let result = emitter.finish_volatile_access(error.map_or(Ok(()), |e| Err(e.into())));
+            assert!(result.is_err());
+            assert!(emitter.volatile_source_access.is_none());
+            let mut plain = vec![Operand::IdRef(42)];
+            emitter.mark_source_volatile_access(Op::Load, 42, None, &mut plain);
+            assert_eq!(
+                plain,
+                [Operand::IdRef(42)],
+                "the next Plain access stays Plain after error"
+            );
+        }
+    }
+
+    #[test]
+    fn source_volatile_token_excludes_other_roots_and_read_modify_helpers() {
+        let module = LlModule::parse("define void @k() {\nentry:\n ret void\n}").unwrap();
+        let mut emitter = Emitter::new(module);
+        emitter.volatile_source_access = Some(VolatileSourceAccess {
+            op: Op::Store,
+            target: VolatileAccessTarget::RawRoot("%actual".into()),
+            hits: 0,
+        });
+        for (op, root) in [
+            (Op::Load, Some("%actual")),
+            (Op::Store, Some("%other")),
+            (Op::Store, None),
+        ] {
+            let mut temporary = vec![Operand::IdRef(42)];
+            emitter.mark_source_volatile_access(op, 42, root, &mut temporary);
+            assert_eq!(temporary, [Operand::IdRef(42)]);
+        }
+        let mut source = vec![Operand::IdRef(42), Operand::IdRef(43)];
+        emitter.mark_source_volatile_access(Op::Store, 42, Some("%actual"), &mut source);
+        assert_eq!(
+            source.last(),
+            Some(&Operand::MemoryAccess(MemoryAccess::VOLATILE))
+        );
+        emitter.finish_volatile_access(Ok(())).unwrap();
+        assert!(emitter.volatile_source_access.is_none());
+    }
+}
