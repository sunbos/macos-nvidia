+            ("volatile payload load", "  %second = load volatile ptr addrspace(3), ptr %again\n  ret void", "void", ""),
+            ("bitcast holder", "  %alias = bitcast ptr %again to ptr\n  %second = load ptr addrspace(3), ptr %alias\n  ret void", "void", ""),
+            ("gep holder", "  %alias = getelementptr ptr addrspace(3), ptr %again, i64 0\n  %second = load ptr addrspace(3), ptr %alias\n  ret void", "void", ""),
+            ("select holder", "  %alias = select i1 %cond, ptr %again, ptr %other\n  %second = load ptr addrspace(3), ptr %alias\n  ret void", "void", ""),
+            ("phi holder", "  br i1 %cond, label %left, label %join\nleft:\n  br label %join\njoin:\n  %alias = phi ptr [ %again, %entry ], [ %other, %left ]\n  %second = load ptr addrspace(3), ptr %alias\n  ret void", "void", ""),
+            ("wrong payload address space", "  %second = load ptr addrspace(2), ptr %again\n  ret void", "void", ""),
+            ("nonpointer payload", "  %second = load i64, ptr %again\n  ret void", "void", ""),
