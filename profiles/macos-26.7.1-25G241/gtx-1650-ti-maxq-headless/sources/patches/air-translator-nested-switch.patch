+//! Layout evidence for passes whose typed IR erases packed struct layout.
+//! Check ORIGINAL alloca/GEP types, before resolving Named types. An erased
+//! anonymous Struct alone cannot establish that its source was not packed.
+use super::LlType;
+use crate::native::parse::{parse_type, strip_comment};
+use std::collections::{HashMap, HashSet};
+
+pub(in crate::native) struct LayoutProof {
+    ordinary: HashMap<String, LlType>,
+}
+
+impl LayoutProof {
+    pub(in crate::native) fn new(source: &str, named: &HashMap<String, LlType>) -> Self {
+        let mut ordinary = HashMap::new();
+        let mut forbidden = HashSet::new();
+        // Match the type-definition grammar accepted by LlModule::parse_inner.
+        // Anything absent, opaque, mismatched or packed remains unproved.
+        for raw in source.lines() {
+            let line = strip_comment(raw).trim();
+            if !line.starts_with('%') { continue; }
+            let Some((name, body)) = line.split_once(" = type ") else { continue; };
+            let name = name.trim();
+            if contains_inline_packed(body) {
+                forbidden.insert(name.to_string());
+                continue;
+            }
+            if let Ok(parsed) = parse_type(body.trim()) {
+                if named.get(name) == Some(&parsed) {
+                    ordinary.insert(name.to_string(), parsed);
+                } else {
+                    forbidden.insert(name.to_string());
+                }
+            } else {
+                forbidden.insert(name.to_string());
+            }
+        }
+        ordinary.retain(|name, _| !forbidden.contains(name));
+        Self { ordinary }
+    }
+
+    pub(in crate::native) fn admits(&self, ty: &LlType) -> bool {
+        self.admits_inner(ty, &mut HashSet::new())
+    }
+
+    fn admits_inner(&self, ty: &LlType, visiting: &mut HashSet<String>) -> bool {
+        match ty {
+            LlType::Named(name) => {
+                if !visiting.insert(name.clone()) { return false; }
+                let proven = self.ordinary.get(name)
+                    .is_some_and(|body| self.admits_inner(body, visiting));
+                visiting.remove(name);
+                proven
+            }
+            LlType::Struct(fields) => fields.iter().all(|field| self.admits_inner(field, visiting)),
+            LlType::Array(element, _) | LlType::Vector(element, _) => self.admits_inner(element, visiting),
+            // These are scalar/pointer layouts, independent of a pointee's
+            // packing. Pointer-derived GEPs still require their own check.
+            _ => true,
+        }
+    }
+}
+
+pub(in crate::native) fn contains_inline_packed(source: &str) -> bool {
+    // parse_type trims Unicode whitespace inside angle brackets; use the same
+    // whitespace class here. False positives in quoted text are conservative.
+    let compact: String = source.lines().flat_map(|line| strip_comment(line).chars())
+        .filter(|ch| !ch.is_whitespace()).collect();
+    compact.contains("<{")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::native::ir::LlModule;
+    fn proof(source: &str) -> LayoutProof {
+        let module = LlModule::parse(&format!("{source}define void @k() {{\nentry:\n  ret void\n}}\n")).expect("synthetic type declarations parse");
+        LayoutProof::new(source, &module.types)
+    }
+    #[test]
+    fn pointer_layout_ordinary_closure_survives_unrelated_packed_type() {
+        let p = proof("%Closure = type { ptr, ptr addrspace(2) }\n%Other = type <{ i8, ptr }>\n");
+        assert!(p.admits(&LlType::Named("%Closure".into())));
+        assert!(!p.admits(&LlType::Named("%Other".into())));
+        assert!(p.admits(&LlType::Ptr(0)));
+    }
+    #[test]
+    fn pointer_layout_rejects_packed_with_parser_accepted_whitespace() {
+        for spelling in ["<{ i8, ptr }>", "< { i8, ptr } >", "<\t{ i8, ptr }\t>", "<\u{2003}{ i8, ptr }>"] {
+            let source=format!("%Packed = type {spelling}\n");
+            let p=proof(&source);
+            assert!(contains_inline_packed(spelling), "{spelling}");
+            assert!(!p.admits(&LlType::Named("%Packed".into())), "{spelling}");
+        }
+    }
+    #[test]
+    fn pointer_layout_rejects_nested_and_aliased_packed_types() {
+        let p=proof("%Packed = type < { i8, ptr } >\n%Alias = type %Packed\n%Outer = type { i32, [2 x %Alias] }\n%Inline = type { i32, < { i8, ptr } > }\n");
+        for name in ["%Packed","%Alias","%Outer","%Inline"] {
+            assert!(!p.admits(&LlType::Named(name.into())), "{name}");
+        }
+    }
+    #[test]
+    fn pointer_layout_accepts_known_aliases_and_rejects_missing_or_cyclic_names() {
+        let p=proof("%Inner = type { ptr }\n%Alias = type %Inner\n%Outer = type { [2 x %Alias] }\n%A = type %B\n%B = type %A\n");
+        assert!(p.admits(&LlType::Named("%Outer".into())));
+        for name in ["%Absent","%A","%B"] { assert!(!p.admits(&LlType::Named(name.into()))); }
+    }
+    #[test]
+    fn pointer_layout_requires_source_evidence_matching_typed_definition() {
+        let source="%A = type { ptr }\n";
+        let names=HashMap::from([("%A".into(), LlType::Struct(vec![LlType::Int(8),LlType::Ptr(0)])), ("%Missing".into(),LlType::Ptr(0))]);
+        let p=LayoutProof::new(source,&names);
+        assert!(!p.admits(&LlType::Named("%A".into())));
+        assert!(!p.admits(&LlType::Named("%Missing".into())));
+    }
+    #[test]
+    fn pointer_layout_inline_scan_catches_whitespace_and_ignores_comments() {
+        assert!(contains_inline_packed("%p = alloca < \t{ i8, ptr } >"));
+        assert!(!contains_inline_packed("; < { ignored } >\n%p = alloca { ptr }"));
+        assert!(!contains_inline_packed("%v = alloca <4 x float>"));
+    }
+}
