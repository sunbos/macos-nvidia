+// Alloca's result address space is a top-level comma-separated qualifier.
+// The allocated element may itself contain pointers in other address spaces.
+fn alloca_result_addrspace(rhs: &str) -> Option<u32> {
+    let mut explicit = None;
+    for part in split_top_level(rhs, ',').into_iter().skip(1) {
+        let Some(suffix) = part.trim().strip_prefix("addrspace") else {
+            continue;
+        };
+        if explicit.is_some() {
+            return None;
+        }
+        let number = suffix.trim().strip_prefix('(')?.strip_suffix(')')?.trim();
+        explicit = Some(number.parse::<u32>().ok()?);
+    }
+    Some(explicit.unwrap_or(0))
