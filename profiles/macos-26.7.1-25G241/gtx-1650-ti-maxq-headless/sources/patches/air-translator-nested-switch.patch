+        let proof = FieldProofContext {
+            named: &module.types,
+            contracts: &contracts,
+            layout: &layout,
+        };
+        let original = module
+            .functions
+            .iter()
+            .find(|f| f.name == "holder_kernel")
+            .unwrap();
