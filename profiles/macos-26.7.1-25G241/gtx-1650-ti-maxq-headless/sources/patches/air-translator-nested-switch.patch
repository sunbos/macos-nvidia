+// Read-only proof boundary for callers whose typed operands do not retain
+// operand bundles. This does not change parse_call's accepted syntax.
+pub(super) fn direct_call_suffix(line: &str) -> Option<&str> {
+    let line = strip_comment(line).trim();
+    let parts = split_top_level(line, '=');
