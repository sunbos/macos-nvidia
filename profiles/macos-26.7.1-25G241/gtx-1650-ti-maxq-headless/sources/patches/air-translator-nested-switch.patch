+    // callee. Named return types are conservatively outside this proof helper.
+    if call[..at].contains(['%', '"']) {
+        return None;
+    }
+    let (_, open) = parse_global_symbol_with_params(call, at, "call proof").ok()?;
+    if !call[at..].starts_with("@\"") && call[at..open].contains(['[', ']', ')']) {
+        return None;
+    }
+    let close = matching_paren(call, open)?;
+    // matching_paren does not model quoted argument names. A quoted callee is
+    // handled by the existing symbol parser above; uncertain arguments decline.
+    if call[open + 1..close].contains('"') {
+        return None;
+    }
+    Some(call[close + 1..].trim())
