+//! Preserve access effects that LlLoad's type-oriented parser erases.
+use crate::native::lex::{split_top_level, strip_comment};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(in crate::native) enum MemoryAccess {
+    Plain,
+    Volatile,
+    Atomic,
+    Unknown,
+}
+
+pub(in crate::native) fn memory_access_from_source(line: &str) -> MemoryAccess {
+    let parts = split_top_level(strip_comment(line).trim(), '=');
+    let rhs = match parts.as_slice() {
+        [rhs] | [_, rhs] => rhs,
+        _ => return MemoryAccess::Unknown,
+    };
+    let mut words = rhs.split_whitespace();
+    if !matches!(words.next(), Some("load" | "store")) {
+        return MemoryAccess::Unknown;
+    }
+    let (mut atomic, mut volatile) = (false, false);
+    for word in words {
+        match word {
+            "atomic" if !atomic => atomic = true,
+            "volatile" if !volatile => volatile = true,
+            "atomic" | "volatile" => return MemoryAccess::Unknown,
+            _ => {
+                return if atomic {
+                    MemoryAccess::Atomic
+                } else if volatile {
+                    MemoryAccess::Volatile
+                } else {
+                    MemoryAccess::Plain
+                }
+            }
+        }
+    }
+    MemoryAccess::Unknown
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn memory_access_retains_modifiers_and_quoted_assignment_names() {
+        for (line, expected) in [
+            (
+                r#"%"a=b" = load volatile ptr, ptr %field"#,
+                MemoryAccess::Volatile,
+            ),
+            (
+                r#"%"volatile" = load ptr, ptr %field ; volatile"#,
+                MemoryAccess::Plain,
+            ),
+            ("store volatile ptr %x, ptr %field", MemoryAccess::Volatile),
+            (
+                "%x = load atomic volatile i32, ptr %field seq_cst",
+                MemoryAccess::Atomic,
+            ),
+            (
+                "%x = load atomic i32, ptr %field seq_cst",
+                MemoryAccess::Atomic,
+            ),
+            ("%x = load", MemoryAccess::Unknown),
+            ("volatile ptr, ptr %field", MemoryAccess::Unknown),
+            (
+                "%x = load volatile volatile ptr, ptr %field",
+                MemoryAccess::Unknown,
+            ),
+        ] {
+            assert_eq!(memory_access_from_source(line), expected, "{line}");
+        }
+    }
+}
