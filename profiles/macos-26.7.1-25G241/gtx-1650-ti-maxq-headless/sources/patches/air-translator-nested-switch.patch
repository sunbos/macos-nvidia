+// An aggregate extraction reads an immutable SSA value, not memory. Admit only
+// parsed, static paths; unresolved operands/types must stay in their source case.
+fn aggregate_extraction_source(inst: &tir::TirInst) -> Option<&str> {
+    if inst.opcode != tir::TirOpcode::ExtractValue
+        || !matches!(
+            inst.result_ty,
+            Some(LlType::Ptr(_) | LlType::Struct(_) | LlType::Array(_, _) | LlType::Named(_))
+        )
+        || !inst
+            .aggregate_indices()
+            .as_ref()
+            .is_some_and(|indices| !indices.is_empty())
+    {
+        return None;
+    }
+    match inst.operands.as_slice() {
+        [tir::TirOperand::Value {
+            name,
+            ty: LlType::Struct(_) | LlType::Array(_, _) | LlType::Named(_),
+        }] => Some(name),
+        _ => None,
+    }
+}
+
+fn pointer_extraction_dependencies(blocks: &[BodyBlock]) -> HashSet<String> {
+    let definitions = blocks
+        .iter()
+        .filter_map(|block| block.typed.as_ref())
+        .flat_map(|block| &block.insts)
+        .filter_map(|inst| inst.result.as_deref().map(|name| (name, inst)))
+        .collect::<HashMap<_, _>>();
+    let mut pending = definitions
+        .iter()
+        .filter_map(|(&name, inst)| {
+            (matches!(inst.result_ty, Some(LlType::Ptr(_)))
+                && aggregate_extraction_source(inst).is_some())
+            .then_some(name)
+        })
+        .collect::<Vec<_>>();
+    let mut needed = HashSet::new();
+    while let Some(name) = pending.pop() {
+        let Some(inst) = definitions.get(name) else {
+            continue;
+        };
+        let Some(source) = aggregate_extraction_source(inst) else {
+            continue;
+        };
+        if needed.insert(name.to_string()) {
+            pending.push(source);
+        }
+    }
+    needed
+}
