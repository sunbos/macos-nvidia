+  %value = load i32, ptr addrspace(2) %constant
+  %scalar_field = getelementptr %Closure, ptr %closure, i64 0, i32 2
+  %scalar = load i32, ptr %scalar_field
+  %again = load ptr, ptr %field
+  br i1 %cond, label %left, label %right
+left:
+  store i32 %scalar, ptr %p
+  br label %right
+right:
+  ret void
+"#,
+            "void",
+            "",
