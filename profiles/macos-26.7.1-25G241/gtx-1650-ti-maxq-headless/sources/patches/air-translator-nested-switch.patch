diff --git a/translator/translator/src/native/ir/helper_specialization.rs b/translator/translator/src/native/ir/helper_specialization.rs
new file mode 100644
--- /dev/null
+++ b/translator/translator/src/native/ir/helper_specialization.rs
@@ -0,0 +1,1110 @@
+//! Lift only closed immutable local captures into real internal helper arguments.
+//! Source ABI evidence is local to this parse; no address-space relabeling occurs.
+use super::fixed_pointer_fields::{CaptureKind, FieldProofContext, Location, ProvenCapture};
+use super::*;
+use std::collections::BTreeMap;
+
+#[derive(Clone, Debug)]
+pub(in crate::native) struct SpecializationOrigin {
+    pub(in crate::native) original: String,
+    pub(in crate::native) linkage: String,
+}
+#[derive(Clone)]
+struct InternalAbi {
+    linkage: String,
+    fastcc: bool,
+}
+
+fn scalar_return(ty: &LlType) -> bool {
+    matches!(
+        ty,
+        LlType::Void
+            | LlType::Bool
+            | LlType::Int(_)
+            | LlType::Float
+            | LlType::Half
+            | LlType::BFloat
+    )
+}
+fn symbol_refs(line: &str) -> Vec<&str> {
+    // Quoted/escaped globals are rejected module-wide by source_abis below.
+    line.split('@')
+        .skip(1)
+        .map(|tail| {
+            let end = tail
+                .find(|c: char| !c.is_ascii_alphanumeric() && !matches!(c, '_' | '.' | '$' | '-'))
+                .unwrap_or(tail.len());
+            &tail[..end]
+        })
+        .collect()
+}
+fn unsupported_abi_attributes(line: &str) -> bool {
+    [
+        "byval(",
+        "byref(",
+        "sret(",
+        "inalloca(",
+        "preallocated(",
+        "swiftself",
+        "swifterror",
+        "swiftasync",
+        "inreg",
+        "nest",
+        "returned",
+        "allocalign",
+        "allocptr",
+    ]
+    .iter()
+    .any(|attribute| line.contains(attribute))
+}
+fn attribute_group_only(suffix: &str) -> bool {
+    let suffix = suffix.trim();
+    suffix.is_empty()
+        || suffix
+            .strip_prefix('#')
+            .is_some_and(|number| !number.is_empty() && number.bytes().all(|b| b.is_ascii_digit()))
+}
+fn ordinary_definition_tail(line: &str) -> bool {
+    let Some(open) = line.find('(') else {
+        return false;
+    };
+    let Some(close) = crate::native::parse::matching_paren(line, open) else {
+        return false;
+    };
+    let Some(tail) = line[close + 1..].trim().strip_suffix('{') else {
+        return false;
+    };
+    let tokens = tail.split_whitespace().collect::<Vec<_>>();
+    let mut i = 0;
+    while i < tokens.len() {
+        match tokens[i] {
+            "unnamed_addr" | "local_unnamed_addr" => {}
+            "align" if tokens.get(i + 1).is_some_and(|n| n.parse::<u64>().is_ok()) => i += 1,
+            group if group.starts_with('#') && attribute_group_only(group) => {}
+            _ => return false,
+        }
+        i += 1;
+    }
+    true
+}
+fn source_abis(
+    ll: &str,
+    functions: &[LlFunction],
+    entries: &HashSet<String>,
+) -> HashMap<String, InternalAbi> {
+    let mut eligible = HashMap::new();
+    // Do not confuse a quoted reference with a different unquoted symbol.
+    if ll.contains("@\"") {
+        return eligible;
+    }
+    for line in ll.lines().map(|l| strip_comment(l).trim()) {
+        if !line.starts_with("define ") {
+            continue;
+        }
+        let Ok(f) = parse_function_header(line) else {
+            continue;
+        };
+        if unsupported_abi_attributes(line) || !ordinary_definition_tail(line) {
+            continue;
+        }
+        if entries.contains(&f.name)
+            || !scalar_return(&f.ret)
+            || f.is_static_initializer
+            || f.byval_param_pointees.iter().any(Option::is_some)
+            || line.contains("...")
+            || line.contains("sret(")
+            || line.contains("inalloca(")
+            || line.contains("preallocated(")
+        {
+            continue;
+        }
+        let Some(at) = line.find('@') else {
+            continue;
+        };
+        let Some(ret) = crate::native::render::render_type(&f.ret) else {
+            continue;
+        };
+        let Some(flags) = line[7..at].trim().strip_suffix(&ret) else {
+            continue;
+        };
+        let flags = flags.split_whitespace().collect::<Vec<_>>();
+        if flags.iter().any(|f| {
+            !matches!(
+                *f,
+                "internal"
+                    | "private"
+                    | "fastcc"
+                    | "ccc"
+                    | "dso_local"
+                    | "zeroext"
+                    | "signext"
+                    | "noundef"
+            )
+        }) {
+            continue;
+        }
+        let linkage = flags
+            .iter()
+            .filter(|f| matches!(**f, "internal" | "private"))
+            .copied()
+            .collect::<Vec<_>>();
+        if linkage.len() != 1
+            || flags
+                .iter()
+                .filter(|f| matches!(**f, "fastcc" | "ccc"))
+                .count()
+                > 1
+        {
+            continue;
+        }
+        eligible.insert(
+            f.name,
+            InternalAbi {
+                linkage: linkage[0].into(),
+                fastcc: flags.contains(&"fastcc"),
+            },
+        );
+    }
+    eligible.retain(|name, abi| {
+        let Some(f) = functions.iter().find(|f| &f.name == name) else {
+            return false;
+        };
+        let Some(ret) = crate::native::render::render_type(&f.ret) else {
+            return false;
+        };
+        let mut definitions = 0;
+        for line in ll.lines().map(|l| strip_comment(l).trim()) {
+            let refs = symbol_refs(line);
+            let count = refs.iter().filter(|r| **r == name).count();
+            if count == 0 {
+                continue;
+            }
+            if count != 1 {
+                return false;
+            }
+            if line.starts_with("define ")
+                && parse_function_header(line)
+                    .ok()
+                    .is_some_and(|f| &f.name == name)
+            {
+                definitions += 1;
+                continue;
+            }
+            let parts = crate::native::parse::split_top_level(line, '=');
+            let rhs = parts.last().copied().unwrap_or(line).trim();
+            let Some(call) = crate::native::parse::strip_call_prefix(rhs) else {
+                return false;
+            };
+            let Some(at) = call.find('@') else {
+                return false;
+            };
+            let Some(flags) = call[..at].trim().strip_suffix(&ret) else {
+                return false;
+            };
+            let flags = flags.split_whitespace().collect::<Vec<_>>();
+            if flags
+                .iter()
+                .any(|f| !matches!(*f, "fastcc" | "ccc" | "zeroext" | "signext" | "noundef"))
+                || flags.contains(&"fastcc") != abi.fastcc
+                || flags
+                    .iter()
+                    .filter(|f| matches!(**f, "fastcc" | "ccc"))
+                    .count()
+                    > 1
+            {
+                return false;
+            }
+            if unsupported_abi_attributes(call) {
+                return false;
+            }
+            let Some(open) = call[at..].find('(').map(|n| at + n) else {
+                return false;
+            };
+            let Some(close) = crate::native::parse::matching_paren(call, open) else {
+                return false;
+            };
+            if !attribute_group_only(&call[close + 1..]) {
+                return false;
+            }
+            let Ok(call) = crate::native::parse::parse_call(call) else {
+                return false;
+            };
+            if &call.callee != name
+                || call.ret != f.ret
+                || call.args.len() != f.params.len()
+                || call
+                    .args
+                    .iter()
+                    .zip(&f.params)
+                    .any(|(a, (_, t))| &a.ty != t)
+            {
+                return false;
+            }
+        }
+        definitions == 1 && !recursive(name, functions)
+    });
+    eligible
+}
+fn recursive(name: &str, functions: &[LlFunction]) -> bool {
+    let mut todo = vec![name.to_string()];
+    let mut seen = HashSet::new();
+    while let Some(current) = todo.pop() {
+        if !seen.insert(current.clone()) {
+            continue;
+        }
+        if let Some(f) = functions.iter().find(|f| f.name == current) {
+            for call in f.carrier_insts().filter_map(|i| i.call().as_deref()) {
+                if call.callee == name {
+                    return true;
+                }
+                todo.push(call.callee.clone());
+            }
+        }
+    }
+    false
+}
+
+pub(super) fn specialize(
+    functions: &mut Vec<LlFunction>,
+    entries: &HashSet<String>,
+    reserved: &HashSet<String>,
+    raw_source: &str,
+    unsupported: &HashSet<String>,
+    proof: &FieldProofContext<'_>,
+) -> HashMap<String, SpecializationOrigin> {
+    let eligible = source_abis(raw_source, functions, entries);
+    let mut occupied = reserved.clone();
+    occupied.extend(functions.iter().map(|f| f.name.clone()));
+    let mut origins = HashMap::new();
+    let original_count = functions.len();
+    for caller_index in 0..original_count {
+        if unsupported.contains(&functions[caller_index].name)
+            || !functions[caller_index].carrier_insts().any(|i| {
+                i.call()
+                    .as_ref()
+                    .is_some_and(|c| eligible.contains_key(&c.callee))
+            })
+        {
+            continue;
+        }
+        let mut sites: BTreeMap<Location, Vec<ProvenCapture>> = BTreeMap::new();
+        for capture in fixed_pointer_fields::proven_call_captures(&functions[caller_index], proof) {
+            if eligible.contains_key(&capture.callee) {
+                sites.entry(capture.at).or_default().push(capture);
+            }
+        }
+        for (at, mut captures) in sites {
+            if origins.len() >= 64 {
+                return origins;
+            }
+            captures.sort_by(|a, b| (a.parameter, &a.path).cmp(&(b.parameter, &b.path)));
+            captures.dedup_by(|a, b| {
+                a.parameter == b.parameter
+                    && a.path == b.path
+                    && a.value == b.value
+                    && a.kind == b.kind
+            });
+            if captures.is_empty() || captures.len() > 32 {
+                continue;
+            }
+            let Some(call) = functions[caller_index].blocks[at.block]
+                .typed
+                .as_ref()
+                .and_then(|b| b.insts.get(at.inst))
+                .and_then(|i| i.call().as_deref())
+                .cloned()
+            else {
+                continue;
+            };
+            if captures.iter().any(|c| c.callee != call.callee) {
+                continue;
+            }
+            let Some(original) = functions.iter().find(|f| f.name == call.callee).cloned() else {
+                continue;
+            };
+            let Some(abi) = eligible.get(&original.name) else {
+                continue;
+            };
+            let mut clone = original.clone();
+            let mut suffix = origins.len();
+            loop {
+                let name = format!("{}.metal2vulkan.capture.{suffix}", original.name);
+                if occupied.insert(name.clone()) {
+                    clone.name = name;
+                    break;
+                }
+                suffix += 1;
+            }
+            let mut substitutions = HashMap::new();
+            let mut arguments = Vec::new();
+            let mut removable_holder_loads = HashSet::new();
+            let mut locals = clone
+                .params
+                .iter()
+                .map(|(n, _)| n.clone())
+                .chain(clone.carrier_insts().filter_map(|i| i.result.clone()))
+                // LLVM parameters, results, and block labels share a namespace.
+                .chain(
+                    clone
+                        .blocks
+                        .iter()
+                        .map(|b| format!("%{}", b.name.trim_start_matches('%'))),
+                )
+                .collect::<HashSet<_>>();
+            for capture in &captures {
+                let Some(contract) = proof
+                    .contracts
+                    .get(&(original.name.clone(), capture.parameter))
+                else {
+                    continue;
+                };
+                let loads: Vec<String> = match capture.kind {
+                    CaptureKind::LocalPointee => contract
+                        .load_results
+                        .iter()
+                        .filter(|(_, field)| {
+                            field.path == capture.path && field.value_type == LlType::Ptr(0)
+                        })
+                        .map(|(result, _)| result.clone())
+                        .collect(),
+                    CaptureKind::WorkgroupPayload => {
+                        let Some(payload_loads) =
+                            contract.workgroup_holder_loads.get(&capture.path)
+                        else {
+                            continue;
+                        };
+                        // Every use of these plain first-level loads was proved
+                        // to be one of the second-level loads being replaced.
+                        removable_holder_loads.extend(
+                            contract
+                                .load_results
+                                .iter()
+                                .filter(|(_, field)| {
+                                    field.path == capture.path && field.value_type == LlType::Ptr(0)
+                                })
+                                .map(|(result, _)| result.clone()),
+                        );
+                        payload_loads.clone()
+                    }
+                };
+                if loads.is_empty() {
+                    continue;
+                }
+                let mut suffix = clone.params.len();
+                let parameter = loop {
+                    let name = format!("%metal2vulkan.capture.{suffix}");
+                    if locals.insert(name.clone()) {
+                        break name;
+                    }
+                    suffix += 1;
+                };
+                clone
+                    .params
+                    .push((parameter.clone(), capture.value.ty.clone()));
+                clone.byval_param_pointees.push(None);
+                arguments.push(capture.value.clone());
+                for result in loads {
+                    substitutions.insert(
+                        result.clone(),
+                        TypedValue {
+                            ty: capture.value.ty.clone(),
+                            value: LlValue::Local(parameter.clone()),
+                        },
+                    );
+                }
+                // `pointee` came from the same actual alloca definition and was
+                // layout-checked. Normal inference sees its actual call argument.
+                debug_assert!(proof.layout.admits(&capture.pointee));
+            }
+            if arguments.is_empty() {
+                continue;
+            }
+            for block in &mut clone.blocks {
+                let typed = block.typed_mut().expect("contract requires typed helper");
+                typed.insts.retain(|i| {
+                    !i.result.as_ref().is_some_and(|r| {
+                        substitutions.contains_key(r) || removable_holder_loads.contains(r)
+                    })
+                });
+                typed.substitute_values(&substitutions);
+            }
+            clone.blocks = crate::native::tir::prune_unused_geps(clone.blocks);
+            let inst = &mut functions[caller_index].blocks[at.block]
+                .typed_mut()
+                .unwrap()
+                .insts[at.inst];
+            if !inst.specialize_direct_call(&call.callee, &clone.name, &arguments) {
+                continue;
+            }
+            origins.insert(
+                clone.name.clone(),
+                SpecializationOrigin {
+                    original: original.name,
+                    linkage: abi.linkage.clone(),
+                },
+            );
+            functions.push(clone);
+        }
+    }
+    debug_assert!(origins.values().all(|origin| eligible
+        .get(&origin.original)
+        .is_some_and(|abi| abi.linkage == origin.linkage)));
+    origins
+}
