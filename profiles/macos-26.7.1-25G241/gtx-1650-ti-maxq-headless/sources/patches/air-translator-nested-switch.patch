+    fn fixed_pointer_fields_effects_still_reject_target_and_helper_accesses() {
+        let helper = r#"
+define void @observe_volatile(ptr %box) {
+entry:
+  %field = getelementptr %Closure, ptr %box, i64 0, i32 0
+  %cell = load volatile ptr, ptr %field
+  ret void
+}
+"#;
+        let cases=[
+            BASE.replace("store ptr %slot, ptr %field","store volatile ptr %slot, ptr %field"),
+            BASE.replace("load ptr, ptr %field", "load volatile ptr, ptr %field"),
+            BASE.replace("load ptr, ptr %field, align 8", "load atomic ptr, ptr %field monotonic, align 8"),
+            BASE.replace("  %initial = load ptr", "  call void @observe_volatile(ptr %closure)\n  %initial = load ptr")+helper,
+            BASE.replace("  %initial = load ptr", "  %alias = bitcast ptr %field to ptr\n  %ignored = load volatile ptr, ptr %alias\n  %initial = load ptr"),
+        ];
+        for source in cases {
+            let module = LlModule::parse(&source).expect("effect fixture parses");
+            let function = module.functions.iter().find(|f| f.name == "k").unwrap();
+            assert!(
+                function
+                    .carrier_insts()
+                    .any(|i| i.result.as_deref() == Some("%initial"))
+                    && function
+                        .carrier_insts()
+                        .any(|i| i.result.as_deref() == Some("%next")),
+                "effectful target must remain unproved"
+            );
+        }
+    }
+
+    #[test]
+    fn fixed_pointer_fields_multiline_volatile_is_rejected() {
+        let source = BASE.replace(
+            "  %initial = load ptr, ptr %field, align 8",
+            "  %initial = load\n    volatile ptr, ptr %field, align 8",
+        );
+        if let Ok(module) = LlModule::parse(&source) {
+            let function = module.functions.iter().find(|f| f.name == "k").unwrap();
+            assert!(
+                function
+                    .carrier_insts()
+                    .any(|i| i.result.as_deref() == Some("%next")),
+                "unmodelled multiline effect cannot forward target reloads"
+            );
+        }
+    }
+
+    #[test]
+    fn fixed_pointer_fields_helper_unrelated_workgroup_volatile() {
+        let source=BASE.replace("define void @k()", "define void @k(ptr addrspace(3) %group)")
+            .replace("  %initial = load ptr", "  call void @observe(ptr %closure, ptr addrspace(3) %group)\n  %initial = load ptr") + r#"
+define void @observe(ptr %box, ptr addrspace(3) %group) {
+entry:
+  %field = getelementptr %Closure, ptr %box, i64 0, i32 0
+  %cell = load ptr, ptr %field
+  %observed = load volatile float, ptr addrspace(3) %group
+  ret void
+}
+"#;
+        assert_eq!(entry_pointer_loads(&source), 0);
+        let module = LlModule::parse(&source).unwrap();
+        assert!(module
+            .functions
+            .iter()
+            .find(|f| f.name == "observe")
+            .unwrap()
+            .carrier_insts()
+            .any(|i| i.result.as_deref() == Some("%observed")
+                && i.memory_access() == Some(crate::native::tir::MemoryAccess::Volatile)));
+    }
+
+    #[test]
+    fn fixed_pointer_fields_helper_volatile_disjoint_loaded_pointee() {
