+            let pointer = TypedValue {
+                ty: LlType::Ptr(0),
+                value: LlValue::Local(name.into()),
+            };
+            let values = [
+                TypedValue {
+                    ty: LlType::Struct(vec![LlType::Ptr(0)]),
+                    value: LlValue::Struct(vec![pointer.clone()]),
+                },
+                TypedValue {
+                    ty: LlType::Ptr(0),
+                    value: LlValue::Gep(Box::new(LlGep {
