+
+    #[test]
+    fn helper_read_contract_canonicalizes_nested_paths_and_analyzes_each_parameter() {
+        let ll = r#"
+%Inner = type { [2 x ptr] }
+%Outer = type { %Inner }
+define void @helper(ptr %a, ptr %b) {
+entry:
+  %outer = getelementptr %Outer, ptr %a, i64 0, i32 0
+  %array = getelementptr %Inner, ptr %outer, i64 0, i32 0
+  %element = getelementptr [2 x ptr], ptr %array, i64 0, i64 1
+  %p = load ptr, ptr %element
+  %same = getelementptr %Outer, ptr %a, i64 0, i32 0, i32 0, i64 1
+  %again = load ptr, ptr %same
+  %bfield = getelementptr %Outer, ptr %b, i64 0, i32 0, i32 0, i64 0
+  %q = load ptr, ptr %bfield
