diff --git a/translator/translator/src/native/ir/helper_read_contract.rs b/translator/translator/src/native/ir/helper_read_contract.rs
new file mode 100644
--- /dev/null
+++ b/translator/translator/src/native/ir/helper_read_contract.rs
@@ -0,0 +1,754 @@
+//! A conditional contract for an address of a caller-owned closed allocation.
+//!
+//! This is not a whole-function readonly guarantee. Callers must independently
+//! prove that the allocation cannot be reached by any other parameter, global,
+//! loaded field, or escaping alias. In particular, loaded pointer values are
+//! contents, not derived closure addresses, and their pointees may be written.
+use super::{LlFunction, LlGep, LlModule, LlType, LlValue};
+use crate::native::tir::{RetEmit, TirOperand, TirTerminator};
+use std::collections::{HashMap, HashSet};
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(in crate::native) struct FieldRead {
+    pub(in crate::native) path: Vec<u32>,
+    pub(in crate::native) value_type: LlType,
+}
+
+/// Calls not using this formal's derived address. These remain proof obligations
+/// for a consumer; lack of a direct address operand is not a no-write guarantee.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(in crate::native) struct CallDependency {
+    pub(in crate::native) callee: String,
+    pub(in crate::native) pointer_argument_count: usize,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(in crate::native) struct ClosureAddressReadContract {
+    pub(in crate::native) root_type: LlType,
+    pub(in crate::native) reads: Vec<FieldRead>,
+    pub(super) load_results: Vec<(String, FieldRead)>,
+    /// A stricter per-field contract: every use of every loaded holder address
+    /// is a plain load of a Workgroup pointer. Callers must still prove that no
+    /// other field, parameter, or escaped address can reach the same holder.
+    pub(super) workgroup_holder_loads: HashMap<Vec<u32>, Vec<String>>,
+    /// Raw types participating in address layout, including named identities.
+    /// The consumer must reject every type whose raw LLVM definition is packed
+    /// (including transitively nested packed members) before using this contract.
+    pub(in crate::native) layout_types: Vec<LlType>,
+    pub(in crate::native) call_dependencies: Vec<CallDependency>,
+}
+
+/// Compute once after parsing the complete module. Absent entries are unknown.
+/// Every aliasing actual argument must have its own contract; the result alone
+/// never authorizes forwarding a memory load or removing a call.
+pub(in crate::native) fn analyze_helper_contracts(
+    module: &LlModule,
+) -> HashMap<(String, usize), ClosureAddressReadContract> {
+    let mut contracts = HashMap::new();
+    for function in &module.functions {
+        for (parameter, (name, ty)) in function.params.iter().enumerate() {
+            if *ty != LlType::Ptr(0) {
+                continue;
+            }
+            if let Some(contract) = analyze_parameter(function, name, &module.types) {
+                contracts.insert((function.name.clone(), parameter), contract);
+            }
+        }
+    }
+    contracts
+}
+
+fn resolved(ty: &LlType, named: &HashMap<String, LlType>) -> Option<LlType> {
+    let mut current = ty.clone();
+    let mut seen = HashSet::new();
+    while let LlType::Named(name) = &current {
+        if !seen.insert(name.clone()) {
+            return None;
+        }
+        current = named.get(name)?.clone();
+    }
+    Some(current)
+}
+
+// LlType deliberately erases packed layout. Preserve all original named and
+// aggregate types, not only the resolved accessed leaf, so the consumer can
+// discharge its raw-source packed-layout obligation. Even an unaccessed member
+// can affect the offset/alignment of a later accessed member.
+fn record_layout_types(
+    ty: &LlType,
+    named: &HashMap<String, LlType>,
+    output: &mut Vec<LlType>,
+) -> Option<()> {
+    fn visit(
+        ty: &LlType,
+        named: &HashMap<String, LlType>,
+        output: &mut Vec<LlType>,
+        active: &mut HashSet<String>,
+    ) -> Option<()> {
+        if let LlType::Named(name) = ty {
+            if active.contains(name) {
+                return None;
+            }
+        }
+        if output.contains(ty) {
+            return Some(());
+        }
+        output.push(ty.clone());
+        match ty {
+            LlType::Named(name) => {
+                active.insert(name.clone());
+                visit(named.get(name)?, named, output, active)?;
+                active.remove(name);
+            }
+            LlType::Struct(members) => {
+                for member in members {
+                    visit(member, named, output, active)?;
+                }
+            }
+            LlType::Array(element, _) | LlType::Vector(element, _) => {
+                visit(element, named, output, active)?
+            }
+            _ => {}
+        }
+        Some(())
+    }
+    visit(ty, named, output, &mut HashSet::new())
+}
+
+fn constant_index(value: &LlValue) -> Option<u32> {
+    match value {
+        LlValue::Int(value) => (*value).try_into().ok(),
+        LlValue::SignedInt(value) => (*value).try_into().ok(),
+        _ => None,
+    }
+}
+
+fn local(value: &LlValue) -> Option<&str> {
+    match value {
+        LlValue::Local(name) => Some(name),
+        _ => None,
+    }
+}
+
+fn derived_field(
+    gep: &LlGep,
+    base: &FieldRead,
+    named: &HashMap<String, LlType>,
+) -> Option<FieldRead> {
+    if gep.base.ty != LlType::Ptr(0)
+        || resolved(&gep.source_ty, named)? != resolved(&base.value_type, named)?
+        || gep
+            .indices
+            .first()
+            .and_then(|index| constant_index(&index.value))
+            != Some(0)
+    {
+        return None;
+    }
+    let mut field = base.clone();
+    for index in &gep.indices[1..] {
+        let index = constant_index(&index.value)?;
+        field.value_type = match resolved(&field.value_type, named)? {
+            LlType::Struct(members) => members.get(index as usize)?.clone(),
+            LlType::Array(element, count) if index < count => *element,
+            _ => return None,
+        };
+        field.path.push(index);
+    }
+    Some(field)
+}
+
+fn contains_address(value: &LlValue, addresses: &HashMap<String, FieldRead>) -> bool {
+    match value {
+        LlValue::Local(name) => addresses.contains_key(name),
+        LlValue::Gep(gep) => {
+            contains_address(&gep.base.value, addresses)
+                || gep
+                    .indices
+                    .iter()
+                    .any(|index| contains_address(&index.value, addresses))
+        }
+        LlValue::Vector(values) | LlValue::Array(values) | LlValue::Struct(values) => values
+            .iter()
+            .any(|value| contains_address(&value.value, addresses)),
+        LlValue::Splat(value) | LlValue::IntToPtr { source: value, .. } => {
+            contains_address(&value.value, addresses)
+        }
+        _ => false,
+    }
+}
+
+fn workgroup_holder_loads(
+    function: &LlFunction,
+    load_results: &[(String, FieldRead)],
+    named: &HashMap<String, LlType>,
+) -> HashMap<Vec<u32>, Vec<String>> {
+    let mut holders_by_path: HashMap<Vec<u32>, HashMap<String, FieldRead>> = HashMap::new();
+    for (result, field) in load_results {
+        if resolved(&field.value_type, named) == Some(LlType::Ptr(0)) {
+            holders_by_path
+                .entry(field.path.clone())
+                .or_default()
+                .insert(result.clone(), field.clone());
+        }
+    }
+
+    let mut output = HashMap::new();
+    'field: for (path, holders) in holders_by_path {
+        let mut payload_loads = Vec::new();
+        for block in &function.blocks {
+            let Some(block) = &block.typed else {
+                // An absent typed carrier cannot establish the absence of uses.
+                return HashMap::new();
+            };
+            if let RetEmit::Value(value) = &block.ret {
+                if contains_address(&value.value, &holders) {
+                    continue 'field;
+                }
+            }
+            match &block.terminator {
+                TirTerminator::Ret(_) if matches!(block.ret, RetEmit::FromText) => {
+                    continue 'field;
+                }
+                TirTerminator::Ret(Some(value)) if holders.contains_key(value) => {
+                    continue 'field;
+                }
+                TirTerminator::BrCond { cond, .. } if holders.contains_key(cond) => {
+                    continue 'field;
+                }
+                TirTerminator::Switch { selector, .. } if holders.contains_key(selector) => {
+                    continue 'field;
+                }
+                _ => {}
+            }
+            for inst in &block.insts {
+                if inst
+                    .operands
+                    .iter()
+                    .any(|operand| matches!(operand, TirOperand::Unresolved))
+                {
+                    continue 'field;
+                }
+                let uses_holder = inst.uses_any(|name| holders.contains_key(name))
+                    || inst.operands.iter().any(|operand| match operand {
+                        TirOperand::Value { name, .. } => holders.contains_key(name),
+                        TirOperand::Const { value, .. } => contains_address(value, &holders),
+                        TirOperand::Unresolved => true,
+                    });
+                if !uses_holder {
+                    continue;
+                }
+                // Closure-address readonly alone allows pointee writes. This
+                // stricter proof admits only the direct second-level load;
+                // aliases, stores, calls and even volatile loads of the holder
+                // must retain the original indirection.
+                let Some(load) = inst.load() else {
+                    continue 'field;
+                };
+                if inst.memory_access() != Some(crate::native::tir::MemoryAccess::Plain)
+                    || load.ptr.ty != LlType::Ptr(0)
+                    || load.result_ty != LlType::Ptr(3)
+                    || !local(&load.ptr.value).is_some_and(|name| holders.contains_key(name))
+                {
+                    continue 'field;
+                }
+                let Some(result) = &inst.result else {
+                    continue 'field;
+                };
+                payload_loads.push(result.clone());
+            }
+        }
+        if !payload_loads.is_empty() {
+            output.insert(path, payload_loads);
+        }
+    }
+    output
+}
+
+fn analyze_parameter(
+    function: &LlFunction,
+    parameter: &str,
+    named: &HashMap<String, LlType>,
+) -> Option<ClosureAddressReadContract> {
+    let blocks = function
+        .blocks
+        .iter()
+        .map(|block| block.typed.as_ref())
+        .collect::<Option<Vec<_>>>()?;
+    let mut root_type = None;
+    let mut layout_types = Vec::new();
+    for inst in blocks.iter().flat_map(|block| &block.insts) {
+        if inst.memory_access().is_some_and(|access| {
+            matches!(
+                access,
+                crate::native::tir::MemoryAccess::Atomic
+                    | crate::native::tir::MemoryAccess::Unknown
+            )
+        }) {
+            return None;
+        }
+        if inst
+            .operands
+            .iter()
+            .any(|operand| matches!(operand, TirOperand::Unresolved))
+        {
+            return None;
+        }
+        let Some(gep) = inst.gep() else {
+            continue;
+        };
+        if local(&gep.base.value) != Some(parameter) {
+            continue;
+        }
+        let source = resolved(&gep.source_ty, named)?;
+        if !matches!(source, LlType::Struct(_) | LlType::Array(_, _))
+            || root_type
+                .as_ref()
+                .is_some_and(|prior| resolved(prior, named).as_ref() != Some(&source))
+        {
+            return None;
+        }
+        record_layout_types(&gep.source_ty, named, &mut layout_types)?;
+        root_type.get_or_insert_with(|| gep.source_ty.clone());
+    }
+    let root_type = root_type?;
+    let mut addresses = HashMap::from([(
+        parameter.to_string(),
+        FieldRead {
+            path: Vec::new(),
+            value_type: root_type.clone(),
+        },
+    )]);
+    loop {
+        let mut changed = false;
+        for inst in blocks.iter().flat_map(|block| &block.insts) {
+            let (Some(result), Some(gep)) = (&inst.result, inst.gep()) else {
+                continue;
+            };
+            if addresses.contains_key(result) {
+                continue;
+            }
+            let Some(base) = local(&gep.base.value).and_then(|base| addresses.get(base)) else {
+                continue;
+            };
+            if let Some(field) = derived_field(gep, base, named) {
+                record_layout_types(&gep.source_ty, named, &mut layout_types)?;
+                record_layout_types(&field.value_type, named, &mut layout_types)?;
+                addresses.insert(result.clone(), field);
+                changed = true;
+            }
+        }
+        if !changed {
+            break;
+        }
+    }
+    let mut reads = Vec::new();
+    let mut load_results = Vec::new();
+    let mut call_dependencies = Vec::new();
+    for block in blocks {
+        if let RetEmit::Value(value) = &block.ret {
+            if contains_address(&value.value, &addresses) {
+                return None;
+            }
+        }
+        match &block.terminator {
+            TirTerminator::Ret(_) if matches!(block.ret, RetEmit::FromText) => return None,
+            TirTerminator::BrCond { cond, .. } if addresses.contains_key(cond) => return None,
+            TirTerminator::Switch { selector, .. } if addresses.contains_key(selector) => {
+                return None
+            }
+            _ => {}
+        }
+        for inst in &block.insts {
+            let uses_address = inst.uses_any(|name| addresses.contains_key(name));
+            if matches!(
+                inst.opcode.as_str(),
+                "call" | "tail" | "musttail" | "notail"
+            ) {
+                let call = inst.call().as_ref()?;
+                if uses_address
+                    || call
+                        .args
+                        .iter()
+                        .any(|arg| contains_address(&arg.value, &addresses))
+                {
+                    return None;
+                }
+                call_dependencies.push(CallDependency {
+                    callee: call.callee.clone(),
+                    pointer_argument_count: call
+                        .args
+                        .iter()
+                        .filter(|arg| matches!(arg.ty, LlType::Ptr(_)))
+                        .count(),
+                });
+                continue;
+            }
+            if !uses_address {
+                // These instructions remain unchanged. Volatile accesses to
+                // loaded pointees are allowed only under the consumer's closed,
+                // non-self-referential field initialization proof.
+                continue;
+            }
+            if inst
+                .memory_access()
+                .is_some_and(|access| access != crate::native::tir::MemoryAccess::Plain)
+            {
+                return None;
+            }
+            if inst.gep().is_some()
+                && inst
+                    .result
+                    .as_ref()
+                    .is_some_and(|name| addresses.contains_key(name))
+            {
+                continue;
+            }
+            let load = inst.load().as_ref()?;
+            let field = addresses.get(local(&load.ptr.value)?)?;
+            if load.ptr.ty != LlType::Ptr(0)
+                || resolved(&load.result_ty, named)? != resolved(&field.value_type, named)?
+            {
+                return None;
+            }
+            record_layout_types(&load.result_ty, named, &mut layout_types)?;
+            load_results.push((inst.result.clone()?, field.clone()));
+            if !reads.contains(field) {
+                reads.push(field.clone());
+            }
+        }
+    }
+    if reads.is_empty() {
+        return None;
+    }
+    reads.sort_by(|left, right| left.path.cmp(&right.path));
+    let workgroup_holder_loads = workgroup_holder_loads(function, &load_results, named);
+    Some(ClosureAddressReadContract {
+        root_type,
+        reads,
+        load_results,
+        workgroup_holder_loads,
+        layout_types,
+        call_dependencies,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const PREFIX: &str = "%Closure = type { ptr, ptr addrspace(2), i32 }\n";
+
+    fn contracts(ll: &str) -> HashMap<(String, usize), ClosureAddressReadContract> {
+        let module = LlModule::parse(ll).expect("parse synthetic helper");
+        analyze_helper_contracts(&module)
+    }
+
+    fn one(body: &str, ret: &str, tail: &str) -> String {
+        format!("{PREFIX}define {ret} @helper(ptr %closure, ptr %other, i1 %cond) {{\nentry:\n  %field = getelementptr %Closure, ptr %closure, i64 0, i32 0\n{body}\n}}\n{tail}")
+    }
+
+    #[test]
+    fn helper_read_contract_records_mixed_field_reads_and_writable_pointee() {
+        let ll = one(
