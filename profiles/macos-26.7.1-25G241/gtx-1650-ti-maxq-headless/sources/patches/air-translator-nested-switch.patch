+    fn dispatcher_case(module: &Module, state: u32) -> (Word, &Block) {
+        let function = &module.functions[0];
+        for block in &function.blocks {
+            for switch in &block.instructions {
+                if switch.class.opcode != Op::Switch {
+                    continue;
+                }
+                let selector = id_ref(&switch.operands[0]);
+                let Some(load) = function.blocks.iter().flat_map(|block| &block.instructions).find(|inst| {
+                    inst.class.opcode == Op::Load && inst.result_id == Some(selector)
+                }) else { continue };
+                for pair in switch.operands[2..].chunks_exact(2) {
+                    if pair[0] == Operand::LiteralBit32(state) {
+                        let label = id_ref(&pair[1]);
+                        return (id_ref(&load.operands[0]), function.blocks.iter()
+                            .find(|case| block_id(case) == label).expect("case label"));
+                    }
+                }
+            }
+        }
+        panic!("missing dispatcher case {state}");
+    }
+
+    fn constant_pc_target(module: &Module, state: u32) -> u32 {
+        let (pc, case) = dispatcher_case(module, state);
+        let stores = case.instructions.iter().filter_map(|inst| match inst.operands.as_slice() {
+            [Operand::IdRef(dst), Operand::IdRef(src)]
+                if inst.class.opcode == Op::Store && *dst == pc => Some(*src),
+            _ => None,
+        }).collect::<Vec<_>>();
+        assert_eq!(stores.len(), 1, "one constant PC store in case {state}");
+        module.types_global_values.iter().find_map(|inst| match inst.operands.as_slice() {
+            [Operand::LiteralBit32(value)]
+                if inst.class.opcode == Op::Constant && inst.result_id == Some(stores[0]) => Some(*value),
+            _ => None,
+        }).expect("PC store must use a constant")
+    }
