+// Deliberately bounded: one optional body, one merge, no nested constructs or
+// convergent calls. Keep the existing construction path for every other shape.
+fn proven_three_block_selection(
+    function: &crate::spirv_module::Function,
+    definitions: &HashMap<Word, &Instruction>,
+    value_types: &HashMap<Word, Word>,
+) -> bool {
+    let [entry, body, merge] = function.blocks.as_slice() else {
+        return false;
+    };
+    let label = |block: &crate::spirv_module::Block| block.label.as_ref()?.result_id;
+    let (Some(entry_id), Some(body_id), Some(merge_id)) = (label(entry), label(body), label(merge))
+    else {
+        return false;
+    };
+    if entry_id == body_id || entry_id == merge_id || body_id == merge_id {
+        return false;
+    }
+    let [prefix @ .., selection, branch] = entry.instructions.as_slice() else {
+        return false;
+    };
+    if selection.class.opcode != Op::SelectionMerge
+        || selection.operands.first() != Some(&Operand::IdRef(merge_id))
+        || branch.class.opcode != Op::BranchConditional
+        || !matches!(branch.operands.as_slice(), [Operand::IdRef(_), Operand::IdRef(a), Operand::IdRef(b)]
+            if (*a == body_id && *b == merge_id) || (*b == body_id && *a == merge_id))
+        || !body.instructions.last().is_some_and(|i| {
+            i.class.opcode == Op::Branch && i.operands == [Operand::IdRef(merge_id)]
+        })
+        || !merge
+            .instructions
+            .last()
+            .is_some_and(|i| matches!(i.class.opcode, Op::Return | Op::ReturnValue))
+    {
+        return false;
+    }
+    if prefix
+        .iter()
+        .chain(&body.instructions)
+        .chain(&merge.instructions)
+        .any(|i| {
+            matches!(
+                i.class.opcode,
+                Op::SelectionMerge | Op::LoopMerge | Op::ControlBarrier | Op::FunctionCall
+            )
+        })
+    {
+        return false;
+    }
+    !blocks_have_unowned_selection_header(&function.blocks)
+        && !function_has_unowned_backedge(function)
+        && crate::native::owned_cfg::owned_function_layout_error(function, definitions, value_types)
+            .is_none()
+        && crate::native::owned_cfg::owned_function_construction_error(function, value_types)
+            .is_none()
 }
 
