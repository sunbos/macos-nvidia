--- /dev/null
+++ b/translator/translator/src/native/ir/fixed_pointer_fields.rs
@@ -0,0 +1,1516 @@
+//! Prove immutable local pointer fields before CFG ownership rewrites introduce
+//! forward pointer PHIs. Unexplained uses leave the entire allocation untouched.
+use super::helper_read_contract::ClosureAddressReadContract;
+use super::pointer_layout::{contains_inline_packed, LayoutProof};
+use super::{LlFunction, LlGep, LlType, LlValue, TypedValue};
+
+pub(super) struct FieldProofContext<'a> {
+    pub(super) named: &'a HashMap<String, LlType>,
+    pub(super) contracts: &'a HashMap<(String, usize), ClosureAddressReadContract>,
+    pub(super) layout: &'a LayoutProof,
+}
+use crate::native::cfg::{graph, BodyBlock};
+use crate::native::tir::{RetEmit, TirOperand, TirTerminator};
+use std::collections::{HashMap, HashSet};
+
+#[derive(Clone)]
+struct Field {
+    path: Vec<u32>,
+    ty: LlType,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub(super) struct Location {
+    pub(super) block: usize,
+    pub(super) inst: usize,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum CaptureKind {
+    LocalPointee,
+    WorkgroupPayload,
+}
+#[derive(Clone, Debug)]
+pub(super) struct ProvenCapture {
+    pub(super) kind: CaptureKind,
+    pub(super) at: Location,
+    pub(super) callee: String,
+    pub(super) parameter: usize,
+    pub(super) path: Vec<u32>,
+    pub(super) value: TypedValue,
+    pub(super) pointee: LlType,
+}
+struct ProvenRoot {
+    substitutions: HashMap<String, TypedValue>,
+    captures: Vec<ProvenCapture>,
+}
+
+fn plain_pointee(ty: &LlType, proof: &FieldProofContext<'_>) -> bool {
+    if !proof.layout.admits(ty) {
+        return false;
+    }
+    match resolved(ty, proof.named) {
+        Some(LlType::Bool | LlType::Int(_) | LlType::Float | LlType::Half | LlType::BFloat) => true,
+        Some(LlType::Vector(ty, _) | LlType::Array(ty, _)) => plain_pointee(&ty, proof),
+        Some(LlType::Struct(fields)) => fields.iter().all(|ty| plain_pointee(ty, proof)),
+        _ => false,
+    }
+}
+
+fn resolved(ty: &LlType, named: &HashMap<String, LlType>) -> Option<LlType> {
+    let mut ty = ty.clone();
+    let mut seen = HashSet::new();
+    while let LlType::Named(name) = &ty {
+        if !seen.insert(name.clone()) {
+            return None;
+        }
+        ty = named.get(name)?.clone();
+    }
+    Some(ty)
+}
+
+fn index(value: &LlValue) -> Option<u32> {
+    match value {
+        LlValue::Int(n) => (*n).try_into().ok(),
+        LlValue::SignedInt(n) => (*n).try_into().ok(),
+        _ => None,
+    }
+}
+
+fn local(value: &LlValue) -> Option<&str> {
+    match value {
+        LlValue::Local(name) => Some(name),
+        _ => None,
+    }
+}
+
+fn field_gep(
+    gep: &LlGep,
+    base: &Field,
+    named: &HashMap<String, LlType>,
+    layout: &LayoutProof,
+) -> Option<Field> {
+    if !layout.admits(&gep.source_ty)
+        || !layout.admits(&base.ty)
+        || gep.base.ty != LlType::Ptr(0)
+        || resolved(&gep.source_ty, named)? != resolved(&base.ty, named)?
+        || gep.indices.first().and_then(|i| index(&i.value)) != Some(0)
+    {
+        return None;
+    }
+    let mut field = base.clone();
+    for part in &gep.indices[1..] {
+        let n = index(&part.value)?;
+        field.ty = match resolved(&field.ty, named)? {
+            LlType::Struct(fields) => fields.get(n as usize)?.clone(),
+            LlType::Array(elem, count) if n < count => *elem,
+            _ => return None,
+        };
+        field.path.push(n);
+    }
+    field.ty = resolved(&field.ty, named)?;
+    Some(field)
+}
+
+fn dominates(
+    before: Location,
+    after: Location,
+    blocks: &[BodyBlock],
+    dom: &graph::Dominators,
+) -> bool {
+    if before.block == after.block {
+        before.inst < after.inst
+    } else {
+        dom.dominates(&blocks[before.block].name, &blocks[after.block].name)
+    }
+}
+
+fn aliases_value(value: &LlValue, aliases: &HashMap<String, Field>) -> bool {
+    match value {
+        LlValue::Local(name) => aliases.contains_key(name),
+        LlValue::Gep(gep) => aliases_value(&gep.base.value, aliases),
+        LlValue::Vector(values) | LlValue::Array(values) | LlValue::Struct(values) => {
+            values.iter().any(|v| aliases_value(&v.value, aliases))
+        }
+        LlValue::Splat(value) | LlValue::IntToPtr { source: value, .. } => {
+            aliases_value(&value.value, aliases)
+        }
+        _ => false,
+    }
+}
+
+fn replacements_for_root(
+    root: &str,
+    root_ty: &LlType,
+    blocks: &[BodyBlock],
+    params: &[(String, LlType)],
+    proof: &FieldProofContext<'_>,
+    allocas: &HashMap<String, (LlType, Location)>,
+    dom: &graph::Dominators,
+) -> Option<ProvenRoot> {
+    let named = proof.named;
+    let mut lifetime_aliases = HashSet::new();
+    let mut aliases = HashMap::from([(
+        root.to_string(),
+        Field {
+            path: Vec::new(),
+            ty: root_ty.clone(),
+        },
+    )]);
+    // The only accepted derived address is a bounded, constant typed field
+    // path. A bitcast, dynamic index or type-punning use rejects this root below.
+    loop {
+        let mut changed = false;
+        for inst in blocks
+            .iter()
+            .filter_map(|b| b.typed.as_ref())
+            .flat_map(|b| &b.insts)
+        {
+            let Some(result) = &inst.result else {
+                continue;
+            };
+            if aliases.contains_key(result) {
+                continue;
+            }
+            if let Some((source, destination)) = inst.bitcast() {
+                if source.ty == LlType::Ptr(0)
+                    && crate::native::parse::parse_type(destination).ok() == Some(LlType::Ptr(0))
+                {
+                    if let Some(base) = local(&source.value).and_then(|name| aliases.get(name)) {
+                        if base.path.is_empty() {
+                            aliases.insert(result.clone(), base.clone());
+                            lifetime_aliases.insert(result.clone());
+                            changed = true;
+                        }
+                    }
+                }
+                continue;
+            }
+            let Some(gep) = inst.gep() else {
+                continue;
+            };
+            if aliases.contains_key(result) {
+                continue;
+            }
+            let Some(base) = local(&gep.base.value).and_then(|name| aliases.get(name)) else {
+                continue;
+            };
+            if local(&gep.base.value).is_some_and(|name| lifetime_aliases.contains(name)) {
+                continue;
+            }
+            if let Some(field) = field_gep(gep, base, named, proof.layout) {
+                aliases.insert(result.clone(), field);
+                changed = true;
+            }
+        }
+        if !changed {
+            break;
+        }
+    }
+    let mut stores: HashMap<Vec<u32>, Vec<(Location, TypedValue)>> = HashMap::new();
+    let mut loads: HashMap<Vec<u32>, Vec<(Location, String)>> = HashMap::new();
+    let mut helper_reads: Vec<(Location, String, usize, Vec<u32>, LlType)> = Vec::new();
+    for (bi, block) in blocks.iter().enumerate() {
+        let typed = block.typed.as_ref()?;
+        if let RetEmit::Value(value) = &typed.ret {
+            if aliases_value(&value.value, &aliases) {
+                return None;
+            }
+        }
+        for (ii, inst) in typed.insts.iter().enumerate() {
+            if !inst.uses_any(|name| aliases.contains_key(name)) {
+                continue;
+            }
+            if inst
+                .memory_access()
+                .is_some_and(|access| access != crate::native::tir::MemoryAccess::Plain)
+            {
+                return None;
+            }
+            let at = Location {
+                block: bi,
+                inst: ii,
+            };
+            if inst.bitcast().is_some()
+                && inst
+                    .result
+                    .as_ref()
+                    .is_some_and(|r| lifetime_aliases.contains(r))
+            {
+                continue;
+            }
+            if let Some(call) = inst.call() {
+                let lifetime = matches!(
+                    call.callee.as_str(),
+                    "llvm.lifetime.start.p0" | "llvm.lifetime.end.p0"
+                ) && call.ret == LlType::Void
+                    && call.args.len() == 2
+                    && call.args[0].ty == LlType::Int(64)
+                    && call.args[1].ty == LlType::Ptr(0)
+                    && local(&call.args[1].value)
+                        .and_then(|n| aliases.get(n))
+                        .is_some_and(|field| field.path.is_empty());
+                if lifetime {
+                    continue;
+                }
+                if inst.uses_any(|name| lifetime_aliases.contains(name)) {
+                    return None;
+                }
+                for (argument, value) in call.args.iter().enumerate() {
+                    if !aliases_value(&value.value, &aliases) {
+                        continue;
+                    }
+                    let name = local(&value.value)?;
+                    let field = aliases.get(name)?;
+                    if value.ty != LlType::Ptr(0)
+                        || !field.path.is_empty()
+                        || lifetime_aliases.contains(name)
+                    {
+                        return None;
+                    }
+                    let contract = proof.contracts.get(&(call.callee.clone(), argument))?;
+                    if !proof.layout.admits(&contract.root_type)
+                        || contract
+                            .layout_types
+                            .iter()
+                            .any(|ty| !proof.layout.admits(ty))
+                        || resolved(&contract.root_type, named)? != resolved(&field.ty, named)?
+                    {
+                        return None;
+                    }
+                    helper_reads.extend(contract.reads.iter().map(|read| {
+                        (
+                            at,
+                            call.callee.clone(),
+                            argument,
+                            read.path.clone(),
+                            read.value_type.clone(),
+                        )
+                    }));
+                }
+                // The entire root-use scan proves no address escapes. Every
+                // pointer field read by this helper is initialized below to a
+                // distinct local allocation or an addrspace(2) input; hence its
+                // other parameters, globals and call dependencies cannot reach
+                // this closed allocation through a loaded/self pointer.
+                continue;
+            }
+            if inst.uses_any(|name| lifetime_aliases.contains(name)) {
+                return None;
+            }
+            if inst.gep().is_some()
+                && inst
+                    .result
+                    .as_ref()
+                    .is_some_and(|r| aliases.contains_key(r))
+            {
+                continue;
+            }
+            if let Some(store) = inst.store() {
+                let (value, pointer) = store.as_ref();
+                let field = local(&pointer.value).and_then(|name| aliases.get(name))?;
+                let source = local(&value.value)?;
+                if field.ty != value.ty
+                    || pointer.ty != LlType::Ptr(0)
+                    || aliases.contains_key(source)
+                    || lifetime_aliases.contains(source)
+                {
+                    return None;
+                }
+                match &value.ty {
+                    LlType::Ptr(0) => {
+                        let (_, source_at) = allocas.get(source)?;
+                        if !dominates(*source_at, at, blocks, dom) {
+                            return None;
+                        }
+                    }
+                    LlType::Ptr(2)
+                        if params
+                            .iter()
+                            .any(|(name, ty)| name == source && *ty == LlType::Ptr(2)) => {}
+                    _ => return None,
+                }
+                stores
+                    .entry(field.path.clone())
+                    .or_default()
+                    .push((at, value.clone()));
+            } else if let Some(load) = inst.load() {
+                let field = local(&load.ptr.value).and_then(|name| aliases.get(name))?;
+                if !matches!(field.ty, LlType::Ptr(0) | LlType::Ptr(2))
+                    || load.result_ty != field.ty
+                    || load.ptr.ty != LlType::Ptr(0)
+                {
+                    return None;
+                }
+                loads
+                    .entry(field.path.clone())
+                    .or_default()
+                    .push((at, inst.result.clone()?));
+            } else {
+                // Includes escaping addresses, calls, pointer arithmetic,
+                // aggregate writes, phi/select aliases and unparsed effects.
+                return None;
+            }
+        }
+    }
+    let mut substitutions = HashMap::new();
+    for (path, reads) in &loads {
+        let writes = stores.get(path)?;
+        let [(write_at, value)] = writes.as_slice() else {
+            return None;
+        };
+        for (read_at, result) in reads {
+            if !dominates(*write_at, *read_at, blocks, dom) {
+                return None;
+            }
+            if value.ty == LlType::Ptr(0) {
+                substitutions.insert(result.clone(), value.clone());
+            }
+        }
+    }
+    let mut captures = Vec::new();
+    for (read_at, callee, parameter, path, ty) in &helper_reads {
+        let [(write_at, value)] = stores.get(path)?.as_slice() else {
+            return None;
+        };
+        if value.ty != *ty || !dominates(*write_at, *read_at, blocks, dom) {
+            return None;
+        }
+        if value.ty == LlType::Ptr(0) {
+            let (pointee, _) = allocas.get(local(&value.value)?)?;
+            if plain_pointee(pointee, proof) {
+                captures.push(ProvenCapture {
+                    kind: CaptureKind::LocalPointee,
+                    at: *read_at,
+                    callee: callee.clone(),
+                    parameter: *parameter,
+                    path: path.clone(),
+                    value: value.clone(),
+                    pointee: pointee.clone(),
+                });
+            }
+        }
+    }
+    // All closure reads and alias formals have been proved before a second
+    // level can be exposed. Prove each holder once across every relevant call,
+    // including calls that are not eligible for helper specialization.
+    let paths = helper_reads
+        .iter()
+        .map(|r| r.3.clone())
+        .collect::<HashSet<_>>();
+    for path in paths {
+        let [(capture_at, address)] = stores.get(&path)?.as_slice() else {
+            return None;
+        };
+        let Some(holder) = local(&address.value) else {
+            continue;
+        };
+        let Some((holder_ty, allocated_at)) = allocas.get(holder) else {
+            continue;
+        };
+        if address.ty != LlType::Ptr(0) || *holder_ty != LlType::Ptr(3) {
+            continue;
+        }
+        let Some(payload) = immutable_workgroup_holder(
+            holder,
+            *allocated_at,
+            *capture_at,
+            &path,
+            &loads,
+            &helper_reads,
+            blocks,
+            params,
+            proof,
+            dom,
+        ) else {
+            continue;
+        };
+        for (at, callee, parameter, read_path, _) in &helper_reads {
+            if *read_path == path {
+                captures.push(ProvenCapture {
+                    kind: CaptureKind::WorkgroupPayload,
+                    at: *at,
+                    callee: callee.clone(),
+                    parameter: *parameter,
+                    path: path.clone(),
+                    value: payload.clone(),
+                    pointee: LlType::Ptr(3),
+                });
+            }
+        }
+    }
+    Some(ProvenRoot {
+        substitutions,
+        captures,
+    })
+}
+
+// The ordinary closure contract deliberately permits writes through loaded
+// pointer contents. This separate proof closes the holder itself, not merely
+// its enclosing field. No other field, closure, alias formal or call may retain
+// the holder address. The only exposed value is its original Workgroup input.
+fn immutable_workgroup_holder(
+    holder: &str,
+    allocated_at: Location,
+    capture_at: Location,
+    path: &[u32],
+    field_loads: &HashMap<Vec<u32>, Vec<(Location, String)>>,
+    helper_reads: &[(Location, String, usize, Vec<u32>, LlType)],
+    blocks: &[BodyBlock],
+    params: &[(String, LlType)],
+    proof: &FieldProofContext<'_>,
+    dom: &graph::Dominators,
+) -> Option<TypedValue> {
+    let mut names = HashMap::from([(
+        holder.to_string(),
+        Field {
+            path: Vec::new(),
+            ty: LlType::Ptr(3),
+        },
+    )]);
+    if let Some(reads) = field_loads.get(path) {
+        names.extend(reads.iter().map(|(_, result)| {
+            (
+                result.clone(),
+                Field {
+                    path: Vec::new(),
+                    ty: LlType::Ptr(3),
+                },
+            )
+        }));
+    }
+    // Compiler lifetime markers may use a no-op Ptr0 bitcast of this scalar
+    // holder. Keep these aliases separate from actual holder addresses: they
+    // are accepted only when every use is an exact lifetime marker below.
+    let lifetime_aliases = blocks
+        .iter()
+        .filter_map(|block| block.typed.as_ref())
+        .flat_map(|typed| &typed.insts)
+        .filter_map(|inst| {
+            let (source, destination) = inst.bitcast()?;
+            (source.ty == LlType::Ptr(0)
+                && local(&source.value) == Some(holder)
+                && crate::native::parse::parse_type(&destination).ok() == Some(LlType::Ptr(0)))
+            .then(|| inst.result.clone())
+            .flatten()
+        })
+        .collect::<HashSet<_>>();
+    let uses_holder = |name: &str| names.contains_key(name) || lifetime_aliases.contains(name);
+    // RetEmit values may nest addresses inside GEPs or aggregates. Preserve
+    // the original recursive escape check, including marker-only aliases.
+    let mut return_aliases = names.clone();
+    return_aliases.extend(
+        lifetime_aliases
+            .iter()
+            .map(|name| (name.clone(), names[holder].clone())),
+    );
+    let mut marked_aliases = HashSet::new();
+    let mut read_sites = Vec::new();
+    for (at, callee, parameter, read_path, _) in helper_reads {
+        if read_path != path {
+            continue;
+        }
+        // Check every consumer, not only the call currently being rewritten.
+        // In particular an earlier helper must not overwrite this holder.
+        let contract = proof.contracts.get(&(callee.clone(), *parameter))?;
+        if contract.workgroup_holder_loads.get(path)?.is_empty() {
+            return None;
+        }
+        read_sites.push(*at);
+    }
+    if read_sites.is_empty() {
+        return None;
+    }
+    let mut initializer = None;
+    let mut capture_count = 0;
+    for (bi, block) in blocks.iter().enumerate() {
+        let typed = block.typed.as_ref()?;
+        if matches!(&typed.ret, RetEmit::Value(v) if aliases_value(&v.value, &return_aliases)) {
+            return None;
+        }
+        match &typed.terminator {
+            TirTerminator::BrCond { cond, .. } if uses_holder(cond) => return None,
+            TirTerminator::Switch { selector, .. } if uses_holder(selector) => return None,
+            _ => {}
+        }
+        for (ii, inst) in typed.insts.iter().enumerate() {
+            if !inst.uses_any(&uses_holder) {
+                continue;
+            }
+            let at = Location {
+                block: bi,
+                inst: ii,
+            };
+            if inst.bitcast().is_some()
+                && inst
+                    .result
+                    .as_ref()
+                    .is_some_and(|r| lifetime_aliases.contains(r))
+            {
+                continue;
+            }
+            if let Some(call) = inst.call() {
+                if matches!(
+                    call.callee.as_str(),
+                    "llvm.lifetime.start.p0" | "llvm.lifetime.end.p0"
+                ) && call.ret == LlType::Void
+                    && call.args.len() == 2
+                    && call.args[0].ty == LlType::Int(64)
+                    && call.args[1].ty == LlType::Ptr(0)
+                    // The typed call currently omits suffix operand bundles.
+                    // Require raw evidence with no brackets before treating it
+                    // as an effect-free marker. Normal #attrs/!metadata remain.
+                    && inst.void_call_line().as_ref().is_some_and(|line| !line.contains(['[', ']']))
+                {
+                    if let Some(name) = local(&call.args[1].value) {
+                        if name == holder || lifetime_aliases.contains(name) {
+                            if lifetime_aliases.contains(name) {
+                                marked_aliases.insert(name.to_string());
+                            }
+                            // Markers remain in the IR and do not read the stored
+                            // pointer; start may legally precede its initializer.
+                            continue;
+                        }
+                    }
+                }
+            }
+            if inst.uses_any(|name| lifetime_aliases.contains(name))
+                || inst.memory_access() != Some(crate::native::tir::MemoryAccess::Plain)
+            {
+                return None;
+            }
+            if let Some(store) = inst.store() {
+                let (value, pointer) = store.as_ref();
+                if at == capture_at
+                    && value.ty == LlType::Ptr(0)
+                    && local(&value.value) == Some(holder)
+                {
+                    capture_count += 1;
+                    continue;
+                }
+                if local(&pointer.value) != Some(holder)
+                    || pointer.ty != LlType::Ptr(0)
+                    || value.ty != LlType::Ptr(3)
+                    || !params.iter().any(|(name, ty)| {
+                        *ty == LlType::Ptr(3) && local(&value.value) == Some(name.as_str())
+                    })
+                    || initializer.is_some()
+                    || !dominates(allocated_at, at, blocks, dom)
+                {
+                    return None;
+                }
+                initializer = Some((at, value.clone()));
+            } else if let Some(load) = inst.load() {
+                if load.ptr.ty != LlType::Ptr(0)
+                    || load.result_ty != LlType::Ptr(3)
+                    || !local(&load.ptr.value).is_some_and(|name| names.contains_key(name))
+                {
+                    return None;
+                }
+                read_sites.push(at);
+            } else {
+                // Unknown effects, escapes, alias casts/GEPs, calls, selects,
+                // phis, or another captured field all reject this holder.
+                return None;
+            }
+        }
+    }
+    let (initialized_at, value) = initializer?;
+    if marked_aliases != lifetime_aliases
+        || capture_count != 1
+        || !dominates(initialized_at, capture_at, blocks, dom)
+        || read_sites
+            .iter()
+            .any(|at| !dominates(initialized_at, *at, blocks, dom))
+    {
+        return None;
+    }
+    Some(value)
+}
+
+fn apply(blocks: &mut [BodyBlock], substitutions: &HashMap<String, TypedValue>) {
+    for block in blocks {
+        let Some(typed) = block.typed_mut() else {
+            continue;
+        };
+        typed.insts.retain(|i| {
+            !i.result
+                .as_ref()
+                .is_some_and(|r| substitutions.contains_key(r))
+        });
+        typed.substitute_values(substitutions);
+    }
+}
+
+fn local_allocas(blocks: &[BodyBlock]) -> HashMap<String, (LlType, Location)> {
+    blocks
+        .iter()
+        .enumerate()
+        .flat_map(|(bi, b)| {
+            b.typed.as_ref().into_iter().flat_map(move |t| {
+                t.insts.iter().enumerate().filter_map(move |(ii, i)| {
+                    if i.result_ty != Some(LlType::Ptr(0)) {
+                        return None;
+                    }
+                    Some((
+                        i.result.clone()?,
+                        (
+                            i.alloca_ty().clone()?,
+                            Location {
+                                block: bi,
+                                inst: ii,
+                            },
+                        ),
+                    ))
+                })
+            })
+        })
+        .collect()
+}
+
+pub(super) fn supported_source(source: &[&str]) -> bool {
+    !contains_inline_packed(&source.join("\n"))
+        && !source.iter().any(|line| {
+            let words = crate::native::parse::strip_comment(line)
+                .split_whitespace()
+                .collect::<Vec<_>>();
+            words.iter().any(|token| {
+                matches!(
+                    *token,
+                    "invoke" | "callbr" | "atomic" | "atomicrmw" | "cmpxchg"
+                )
+            }) || (words.contains(&"call")
+                && crate::native::parse::strip_comment(line).contains(['[', ']'])
+                && crate::native::parse::direct_call_suffix(line)
+                    .is_none_or(|suffix| suffix.contains(['[', ']'])))
+                || (words.contains(&"volatile")
+                    && crate::native::tir::memory_access_from_source(line)
+                        == crate::native::tir::MemoryAccess::Unknown)
+        })
+}
+
+// Read-only evidence, recomputed on the final caller immediately before call
+// replacement. Every field/helper read is checked before any capture is exposed.
+pub(super) fn proven_call_captures(
+    function: &LlFunction,
+    proof: &FieldProofContext<'_>,
+) -> Vec<ProvenCapture> {
+    let blocks = &function.blocks;
+    if blocks.iter().any(|b| {
+        b.typed.as_ref().is_none_or(|t| {
+            (matches!(&t.terminator, TirTerminator::Ret(Some(_)))
+                && !matches!(&t.ret, RetEmit::Value(_)))
+                || t.insts.iter().any(|i| {
+                    i.operands
+                        .iter()
+                        .any(|o| matches!(o, TirOperand::Unresolved))
+                })
+        })
+    }) {
+        return Vec::new();
+    }
+    let allocas = local_allocas(blocks);
+    let dom = graph::block_dominators(blocks);
+    let mut captures = Vec::new();
+    for (root, (ty, _)) in &allocas {
+        if !proof.layout.admits(ty) {
+            continue;
+        }
+        let Some(ty) = resolved(ty, proof.named) else {
+            continue;
+        };
+        if !matches!(ty, LlType::Ptr(0) | LlType::Struct(_) | LlType::Array(_, _)) {
+            continue;
+        }
+        if let Some(proven) =
+            replacements_for_root(root, &ty, blocks, &function.params, proof, &allocas, &dom)
+        {
+            captures.extend(proven.captures);
+        }
+    }
+    captures
+}
+
+pub(super) fn forward(function: &mut LlFunction, proof: &FieldProofContext<'_>) {
+    let named = proof.named;
+    let params = &function.params;
+    let blocks = &mut function.blocks;
+    if blocks.iter().any(|b| {
+        b.typed.as_ref().is_none_or(|t| {
+            (matches!(&t.terminator, TirTerminator::Ret(Some(_)))
+                && !matches!(&t.ret, RetEmit::Value(_)))
+                || t.insts.iter().any(|i| {
+                    i.operands
+                        .iter()
+                        .any(|o| matches!(o, TirOperand::Unresolved))
+                })
+        })
+    }) {
+        return;
+    }
+    let allocas = local_allocas(blocks);
+    if allocas.is_empty() {
+        return;
+    }
+    let dom = graph::block_dominators(blocks);
+    let mut substitutions = HashMap::new();
+    for (root, (ty, _)) in &allocas {
+        if !proof.layout.admits(ty) {
+            continue;
+        }
+        let Some(ty) = resolved(ty, named) else {
+            continue;
+        };
+        if !matches!(ty, LlType::Ptr(0) | LlType::Struct(_) | LlType::Array(_, _)) {
+            continue;
+        }
+        if let Some(proven) =
+            replacements_for_root(root, &ty, blocks, params, proof, &allocas, &dom)
+        {
+            substitutions.extend(proven.substitutions);
+        }
+    }
+    apply(blocks, &substitutions);
+
+    let mut predecessors: HashMap<String, HashSet<String>> = HashMap::new();
+    for block in blocks.iter() {
+        for target in block.typed.as_ref().unwrap().terminator.successors() {
+            predecessors
+                .entry(target.to_string())
+                .or_default()
+                .insert(block.name.clone());
+        }
+    }
+    // Only collapse a PHI with one concrete alloca anchor and optional self
+    // backedges. Undef, missing predecessors and genuine different roots remain.
+    loop {
+        // Prior substitutions remove instructions, so refresh same-block positions.
+        let allocas = local_allocas(blocks);
+        let mut replacements = HashMap::new();
+        for (bi, block) in blocks.iter().enumerate() {
+            for (ii, inst) in block.typed.as_ref().unwrap().insts.iter().enumerate() {
+                let (Some(result), Some((LlType::Ptr(0), incoming))) =
+                    (&inst.result, inst.phi_incoming())
+                else {
+                    continue;
+                };
+                let actual = incoming
+                    .iter()
+                    .map(|(_, pred)| pred.clone())
+                    .collect::<HashSet<_>>();
+                if actual.len() != incoming.len() || predecessors.get(&block.name) != Some(&actual)
+                {
+                    continue;
+                }
+                let mut anchor = None;
+                let mut valid = true;
+                for (value, predecessor) in incoming {
+                    if local(value) == Some(result) {
+                        if !dom.dominates(&block.name, predecessor) {
+                            valid = false;
+                            break;
+                        }
+                        continue;
+                    }
+                    let Some(name) = local(value) else {
+                        valid = false;
+                        break;
+                    };
+                    if !allocas.contains_key(name)
+                        || anchor.is_some_and(|previous| previous != name)
+                    {
+                        valid = false;
+                        break;
+                    }
+                    anchor = Some(name);
+                }
+                let Some(anchor) = anchor.filter(|_| valid) else {
+                    continue;
+                };
+                if dominates(
+                    allocas[anchor].1,
+                    Location {
+                        block: bi,
+                        inst: ii,
+                    },
+                    blocks,
+                    &dom,
+                ) {
+                    replacements.insert(
+                        result.clone(),
+                        TypedValue {
+                            ty: LlType::Ptr(0),
+                            value: LlValue::Local(anchor.to_string()),
+                        },
+                    );
+                }
+            }
+        }
+        if replacements.is_empty() {
+            break;
+        }
+        apply(blocks, &replacements);
+    }
