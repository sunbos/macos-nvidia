+/* The experimental headless path is qualified only for this Yoga's TU117. */
+#pragma once
+#include "nvrm_headless_policy.h"
+#include <IOKit/pci/IOPCIDevice.h>
+#include <pexpert/pexpert.h>
+
+static inline bool nvHeadlessProviderAllowed(IOService *provider)
+{
+    unsigned value = 0;
+    const bool present = PE_parse_boot_argn("nvheadless", &value, sizeof value);
+    if (!nvHeadlessBootValue(present, value)) return true;
+    IOPCIDevice *pci = OSDynamicCast(IOPCIDevice, provider);
+    return pci && pci->configRead16(0x00) == 0x10de &&
+           pci->configRead16(0x02) == 0x1f95 &&
+           (pci->configRead32(0x08) >> 8) == 0x030200;
+}
diff --git a/kexts/NVRM/nvrm_headless_policy.h b/kexts/NVRM/nvrm_headless_policy.h
new file mode 100644
--- /dev/null
+++ b/kexts/NVRM/nvrm_headless_policy.h
@@ -0,0 +1,28 @@
+/* Opt-in publication policy shared by the RM/accelerator and host tests. */
+#pragma once
+
+#define NVRM_RM_READY_PROPERTY "nvrm-rm-ready"
+#define NVACCEL_HEADLESS_PROPERTY "NVAccelHeadless"
+
+struct NvHeadlessPublicationInputs {
+    bool requested;
+    bool started;
+    bool stopping;
+    bool samePci;
+    bool rmReady;
+    bool pluginAvailable;
+    bool framebufferSeen;
+    unsigned framebufferCount;
+};
+
+static inline bool nvHeadlessBootValue(bool present, unsigned value)
+{
+    return present && value == 1;
+}
+
+static inline bool nvHeadlessMayPublish(const NvHeadlessPublicationInputs &in)
+{
+    return in.requested && in.started && !in.stopping && in.samePci &&
+           in.rmReady && in.pluginAvailable && !in.framebufferSeen &&
+           in.framebufferCount == 0;
+}
