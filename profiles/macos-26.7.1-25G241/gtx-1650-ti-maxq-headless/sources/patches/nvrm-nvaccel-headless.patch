diff --git a/build/build_nvrm_local.py b/build/build_nvrm_local.py
new file mode 100644
--- /dev/null
+++ b/build/build_nvrm_local.py
@@ -0,0 +1,237 @@
+#!/usr/bin/env python3
+"""Build NVRM only, into a local directory. Never install or load a kext.
+
+The public repository does not include the build-nvrm.sh referenced by rmcc.py.
+This uses NVIDIA's own object rules, then archives Mach-O objects and links the
+XNU adapter. NV_BSD selects the non-Linux Unix version definitions: NV_LINUX
+would also enable Linux-only NVLink locking that the XNU adapter does not supply.
+This is a reproducible development build, not a byte-identical release rebuild.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shlex
+import shutil
+import subprocess
+import sys
+
+
+OGKM_COMMIT = "e4a5faa2567f28c8eabe0ebb6422b6d0abcf37eb"  # NVIDIA 610.57.04
+CORE_DIR = "_out/Darwin_x86_64_bsd"
+CORE_FLAGS = "-DNV_UNIX -DNV_BSD -fapple-kext -mkernel"
+CPP_SOURCES = [
+    "NVRM.cpp", "nv_xnu_stubs.cpp", "os-xnu.cpp", "os-xnu2.cpp",
+    "os-nvkms-xnu.cpp", "nvkms_shaders.cpp", "nvrm_fbinfo.cpp",
+    "nvrm_gpuva.cpp", "nvrm_surfshare.cpp",
+]
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def capture(argv, cwd=None):
+    return subprocess.check_output(argv, cwd=cwd, text=True, stderr=subprocess.PIPE)
+
+
+def run(argv, log, cwd=None):
+    with log.open("w") as stream:
+        result = subprocess.run(argv, cwd=cwd, stdout=stream, stderr=subprocess.STDOUT)
+    if result.returncode:
+        print(log.read_text()[-8000:], file=sys.stderr)
+        raise RuntimeError(f"command failed ({result.returncode}); log: {log}")
+
+
+def object_command(base, component, source, target, logs):
+    argv = base + ["-B", "-n", "NV_VERBOSE=1", target]
+    result = subprocess.run(argv, cwd=component, text=True, capture_output=True)
+    (logs / (component.name + "-command.log")).write_text(result.stdout + result.stderr)
+    if result.returncode:
+        raise RuntimeError(f"cannot obtain {component.name} compiler command")
+    matches = []
+    for line in result.stdout.splitlines():
+        if " && " in line:
+            line = line.split(" && ", 1)[0]
+        tokens = shlex.split(line)
+        if "-c" in tokens and source in tokens:
+            matches.append(tokens)
+    if len(matches) != 1:
+        raise RuntimeError(f"expected one command for {source}, found {len(matches)}")
+    return matches[0]
+
+
+def include_paths(command, cwd):
+    paths = []
+    index = 0
+    while index < len(command):
+        token = command[index]
+        if token == "-I":
+            index += 1
+            paths.append((cwd / command[index]).resolve())
+        elif token.startswith("-I"):
+            paths.append((cwd / token[2:]).resolve())
+        index += 1
+    return paths
+
+
+def compile_internal(command, cwd, original, source, output, log):
+    command = list(command)
+    command[command.index(original)] = str(source)
+    for index, token in enumerate(command):
+        if token == "-o":
+            command[index + 1] = str(output)
+        elif token in ("-MF", "-MT"):
+            command[index + 1] = str(output) + ".d"
+    run(command, log, cwd)
+    return {"cwd": str(cwd), "argv": command}
+
+
+def main():
+    repo = Path(__file__).resolve().parents[1]
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--ogkm", type=Path, required=True)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--src", type=Path, default=repo / "kexts/NVRM")
+    parser.add_argument("--jobs", type=int, default=6)
+    parser.add_argument("--reference", type=Path,
+                        help="optional existing NVRM executable, read only for symbol comparison")
+    args = parser.parse_args()
+    ogkm, out, src = args.ogkm.resolve(), args.out.resolve(), args.src.resolve()
+    if args.jobs < 1:
+        parser.error("--jobs must be positive")
+    if sys.platform != "darwin":
+        parser.error("this development build requires macOS and Xcode")
+    if capture(["git", "rev-parse", "HEAD"], ogkm).strip() != OGKM_COMMIT:
+        parser.error("--ogkm must be NVIDIA's 610.57.04 commit")
+    # Restrict all generated output to a normal development directory.
+    for reserved in (Path("/System"), Path("/Library"), Path("/Volumes")):
+        if out == reserved or reserved in out.parents:
+            parser.error("--out must not be a system or mounted-volume directory")
+    out.mkdir(parents=True, exist_ok=True)
+    logs, objects = out / "logs", out / "objects"
+    logs.mkdir(exist_ok=True)
+    objects.mkdir(exist_ok=True)
+    sdk = Path(capture(["xcrun", "--show-sdk-path"]).strip())
+    compiler = capture(["xcrun", "clang", "--version"])
+    helper = out / "objects.mk"
+    helper.write_text(".PHONY: nvrm-local-objects nvrm-list-objects\n"
+                      "nvrm-local-objects: $(OBJS)\n"
+                      "nvrm-list-objects:\n\t@echo NM_OBJECTS=$(OBJS)\n")
+    make = ["make", "-f", "Makefile", "-f", str(helper), "CC=clang", "CXX=clang++",
+            "OUTPUTDIR=" + CORE_DIR, "EXTRA_CFLAGS=" + CORE_FLAGS]
+    rm, kms = ogkm / "src/nvidia", ogkm / "src/nvidia-modeset"
+    core_commands, archives = [], []
+    for directory, archive in ((rm, "libnvkernel.a"), (kms, "libnvkms.a")):
+        # The five shader ELF wrappers are replaced by nvkms_shaders.cpp.
+        base = make + (["SHADER_OBJS="] if directory == kms else [])
+        print(f"Building {directory.name} objects...", flush=True)
+        argv = base + ["-j" + str(args.jobs), "nvrm-local-objects"]
+        run(argv, logs / (directory.name + "-objects.log"), directory)
+        core_commands.append({"cwd": str(directory), "argv": argv})
+        listing = capture(base + ["nvrm-list-objects"], directory)
+        line = next(line for line in listing.splitlines() if line.startswith("NM_OBJECTS="))
+        members = [(directory / item).resolve() for item in line[11:].split()]
+        for member in members:
+            with member.open("rb") as stream:
+                if stream.read(4) != b"\xcf\xfa\xed\xfe":
+                    raise RuntimeError(f"not a 64-bit Mach-O object: {member}")
+        library = out / archive
+        argv = ["xcrun", "libtool", "-static", "-o", str(library)] + list(map(str, members))
+        run(argv, logs / (archive + ".log"))
+        archives.append(library)
+    rm_command = object_command(make, rm, "arch/nvalloc/unix/src/osapi.c",
+                                CORE_DIR + "/osapi.o", logs)
+    kms_command = object_command(make + ["SHADER_OBJS="], kms, "kapi/src/nvkms-kapi.c",
+                                 CORE_DIR + "/nvkms-kapi.o", logs)
+    # v1.2.0 pairs the allocation-cookie ABI with this upstream completion fix.
+    # Apply it only to an output-directory copy; never modify the vendor tree.
+    completion_patch = src / "patches/610-display-completion.patch"
+    completion_source = out / "completion/nvkms-kapi.c"
+    completion_source.parent.mkdir(exist_ok=True)
+    shutil.copy2(kms / "kapi/src/nvkms-kapi.c", completion_source)
+    run(["patch", "--batch", "--forward", str(completion_source), str(completion_patch)],
+        logs / "completion-patch.log")
+    completion_object = completion_source.with_suffix(".o")
+    completion_command = compile_internal(kms_command, kms, "kapi/src/nvkms-kapi.c",
+        completion_source, completion_object, logs / "completion-compile.log")
+    run(["ar", "r", str(archives[1]), str(completion_object)], logs / "completion-archive.log")
+    run(["ranlib", str(archives[1])], logs / "completion-ranlib.log")
+    # accel_build.sh can reuse precisely the same RM defines through RM_COMMANDS.
+    (out / "rm-compile-command.sh").write_text(shlex.join(rm_command) + "\n")
+    includes = [src] + include_paths(rm_command, rm) + include_paths(kms_command, kms)
+    includes = list(dict.fromkeys(includes))
+    defines = [token for token in rm_command
+               if token.startswith("-D") and token not in ("-DNVRM", "-D_LANGUAGE_C")]
+    flags = ["-arch", "x86_64", "-fapple-kext", "-mkernel", "-nostdinc",
+             "-I" + str(sdk / "System/Library/Frameworks/Kernel.framework/Headers")]
+    flags += ["-I" + str(path) for path in includes]
+    flags += ["-DKERNEL", "-DKERNEL_PRIVATE", "-DDRIVER_PRIVATE", "-DAPPLE", "-DNeXT"]
+    flags += defines + ["-std=c++17", "-fno-rtti", "-fno-exceptions", "-fno-builtin",
+                       "-fno-common", "-Wall", "-Wno-unused-parameter",
+                       "-Wno-inconsistent-missing-override", "-Wno-unused-function", "-O2"]
+    commands = []
+    print("Building XNU adapter objects...", flush=True)
+    for name in CPP_SOURCES:
+        argv = ["xcrun", "clang++"] + flags + ["-c", str(src / name),
+                "-o", str(objects / (Path(name).stem + ".o"))]
+        run(argv, logs / (name + ".log"))
+        commands.append({"argv": argv})
+    for command, cwd, original, name in (
+        (rm_command, rm, "arch/nvalloc/unix/src/osapi.c", "nvrm_pageoff.c"),
+        (kms_command, kms, "kapi/src/nvkms-kapi.c", "nvrm_kapi_fields.c"),
+    ):
+        commands.append(compile_internal(command, cwd, original, src / name,
+                         objects / (Path(name).stem + ".o"), logs / (name + ".log")))
+    contents = out / "NVRM.kext/Contents"
+    (contents / "MacOS").mkdir(parents=True, exist_ok=True)
+    shutil.copy2(src / "Info.plist", contents / "Info.plist")
+    executable = contents / "MacOS/NVRM"
+    # Ordinary archive resolution avoids the duplicate nvstatus.c in RM/KMS.
+    link = ["xcrun", "clang++", "-arch", "x86_64", "-fapple-kext", "-nostdlib",
+            "-Xlinker", "-kext", "-lkmodc++", "-lkmod", "-lcc_kext"]
+    link += [str(objects / (Path(name).stem + ".o"))
+             for name in CPP_SOURCES + ["nvrm_pageoff.c", "nvrm_kapi_fields.c"]]
+    link += list(map(str, archives)) + ["-o", str(executable)]
+    run(link, logs / "link.log")
+    run(["plutil", "-lint", str(contents / "Info.plist")], logs / "plist.log")
+    undefined = sorted(capture(["nm", "-u", str(executable)]).splitlines())
+    internal = [s for s in undefined if re.match(r"^_(nv|rm|port|ceutils|memdesc)", s)]
+    manifest = {
+        "ogkm_commit": OGKM_COMMIT, "core_flags": CORE_FLAGS,
+        "ogkm_dirty": capture(["git", "status", "--porcelain"], ogkm),
+        "sdk": str(sdk), "compiler": compiler, "source": str(src),
+        "source_sha256": {str(p.relative_to(src)): digest(p) for p in src.rglob("*") if p.is_file()},
+        "core_commands": core_commands, "adapter_commands": commands, "link_command": link,
+        "completion": {
+            "patch": str(completion_patch), "patch_sha256": digest(completion_patch),
+            "source": str(completion_source), "source_sha256": digest(completion_source),
+            "object_sha256": digest(completion_object), "archive_sha256": digest(archives[1]),
+            "command": completion_command,
+        },
+        "executable": str(executable), "sha256": digest(executable),
+        "undefined": undefined, "unexpected_internal_undefined": internal,
+        "validation_scope": "offline build and symbol inspection only; not installed or loaded",
+    }
+    if args.reference:
+        previous = set(capture(["nm", "-u", str(args.reference.resolve())]).splitlines())
+        manifest["reference"] = str(args.reference.resolve())
+        manifest["reference_sha256"] = digest(args.reference.resolve())
+        manifest["undefined_added"] = sorted(set(undefined) - previous)
+        manifest["undefined_removed"] = sorted(previous - set(undefined))
+    (out / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    if internal:
+        raise RuntimeError(f"unresolved NVIDIA internal symbols: {internal}")
+    print(f"Built {executable}\nSHA-256 {manifest['sha256']}\n"
+          f"External symbols: {len(undefined)}; see {out / 'manifest.json'}")
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except (RuntimeError, subprocess.CalledProcessError, OSError) as error:
+        print(error, file=sys.stderr)
+        sys.exit(1)
