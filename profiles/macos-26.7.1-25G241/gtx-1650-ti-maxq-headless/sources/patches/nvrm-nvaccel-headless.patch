+static bool nvaccelHeadlessShutdown(void)
+{
+    if (gHeadlessLock) {
+        IOLockLock(gHeadlessLock);
+        bool active = NVAccel::gAccel != nullptr;
+        IOLockUnlock(gHeadlessLock);
+        if (active) return false;
+    }
+    // Unregister handlers before their lock or executable code can disappear.
+    if (gHeadlessOidInstalled) {
+        sysctl_unregister_oid(&sysctl__debug_nvaccel_headless);
+        gHeadlessOidInstalled = false;
+    }
+    if (gHeadlessFbOidInstalled) {
+        sysctl_unregister_oid(&sysctl__debug_nvaccelfb);
+        gHeadlessFbOidInstalled = false;
+    }
+    if (gHeadlessLock) { IOLockFree(gHeadlessLock); gHeadlessLock = nullptr; }
