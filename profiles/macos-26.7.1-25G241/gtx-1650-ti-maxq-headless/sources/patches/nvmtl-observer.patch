+static nvmtl_census_snapshot nvc_totals;
+static nvmtl_census_row nvc_rows[NVMTL_CENSUS_CAPACITY];
+static uint64_t nvc_inflight, nvc_generation;
+
+static void nvc_flag(uint32_t flag) { nvc_totals.flags |= flag; }
+static void nvc_add(uint64_t *value, uint64_t amount)
+{
+    if (UINT64_MAX - *value < amount) { *value = UINT64_MAX; nvc_flag(NVC_OVERFLOW); }
+    else *value += amount;
+}
+static void nvc_sub(uint64_t *value, uint64_t amount)
+{
+    if (*value < amount) { *value = 0; nvc_flag(NVC_OVERFLOW); }
+    else *value -= amount;
+}
+static nvmtl_census_bucket *nvc_bucket(const nvmtl_census_row *row)
+{
+    return &nvc_totals.buckets[row->import_kind][row->location];
+}
+/* Called while locked; memory properties must already be initialized and stable.
+ * Only the allocation chains in this pinned source are understood. Unknown
+ * extensions are classified UNCLASSIFIED and make metadata incomplete, never OWNED.
+ */
+static nvmtl_census_row nvc_request(VkDevice device, const VkMemoryAllocateInfo *info,
+                                  const char *function, uint32_t line)
+{
+    nvmtl_census_row row = {0};
+    row.device = (uintptr_t)device; row.function = function; row.line = line;
+    row.heap_index = UINT32_MAX; row.type_index = UINT32_MAX;
+    row.location = NVC_LOCATION_UNKNOWN;
+    if (!info) { row.import_kind = NVC_UNCLASSIFIED; nvc_flag(NVC_METADATA); return row; }
+    row.size = info->allocationSize; row.type_index = info->memoryTypeIndex;
+    if (info->sType != VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO) nvc_flag(NVC_METADATA);
+    if (row.type_index < g_memp.memoryTypeCount && row.type_index < VK_MAX_MEMORY_TYPES) {
+        row.properties = g_memp.memoryTypes[row.type_index].propertyFlags;
+        row.heap_index = g_memp.memoryTypes[row.type_index].heapIndex;
+        row.location = (row.properties & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) ? NVC_DEVICE_LOCAL : NVC_NONLOCAL;
+        if (row.heap_index < g_memp.memoryHeapCount && row.heap_index < VK_MAX_MEMORY_HEAPS)
+            row.heap_flags = g_memp.memoryHeaps[row.heap_index].flags;
+        else nvc_flag(NVC_METADATA);
+    } else nvc_flag(NVC_METADATA);
+    const VkBaseInStructure *link = (const VkBaseInStructure *)info->pNext;
+    unsigned imports = 0, count = 0;
+    while (link && count++ < 32) {
+        unsigned kind = NVC_OWNED;
+        switch (link->sType) {
+        case VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_FLAGS_INFO: break;
+        case VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT: kind = NVC_IMPORT_HOST; break;
+        case VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR: kind = NVC_IMPORT_FD; break;
+        default: kind = NVC_UNCLASSIFIED; nvc_flag(NVC_METADATA); break;
+        }
+        if (kind != NVC_OWNED) {
+            if (++imports > 1) { row.import_kind = NVC_UNCLASSIFIED; nvc_flag(NVC_METADATA); }
+            else row.import_kind = kind;
+        }
+        link = link->pNext;
+    }
+    if (link) { row.import_kind = NVC_UNCLASSIFIED; nvc_flag(NVC_METADATA); }
+    return row;
+}
+
+int nvmtl_vk_census_begin(void)
+{
+    pthread_mutex_lock(&nvc_lock);
+    int result = nvc_totals.enabled ? 1 : (nvc_inflight ? -1 : 0);
+    if (!result) nvc_totals.enabled = 1;
+    pthread_mutex_unlock(&nvc_lock);
+    return result;
+}
+
+int nvmtl_vk_census_snapshot(nvmtl_census_snapshot *out, nvmtl_census_row *rows, size_t capacity)
+{
+    pthread_mutex_lock(&nvc_lock);
+    if (!out || (!rows && capacity)) {
+        nvc_flag(NVC_OUTPUT_SHORT); pthread_mutex_unlock(&nvc_lock); return -1;
+    }
+    uint32_t count = 0, written = 0;
+    for (size_t i = 0; i < NVMTL_CENSUS_CAPACITY; ++i) {
+        if (nvc_rows[i].state != NVC_LIVE && nvc_rows[i].state != NVC_FREE_PENDING) continue;
+        ++count;
+        if (written < capacity) rows[written++] = nvc_rows[i];
+    }
+    if (written != count) nvc_flag(NVC_OUTPUT_SHORT);
+    *out = nvc_totals;
+    out->version = 1; out->capacity = NVMTL_CENSUS_CAPACITY;
+    out->row_count = count; out->rows_written = written;
+    out->complete = out->enabled && !out->flags;
+    out->physical_placement = NVC_PHYSICAL_PLACEMENT_UNKNOWN;
+    pthread_mutex_unlock(&nvc_lock);
+    return 0;
+}
+
+static VkResult nvmtl_census_allocate(VkDevice device, const VkMemoryAllocateInfo *info,
+                                     const VkAllocationCallbacks *allocator, VkDeviceMemory *out,
+                                     const char *function, uint32_t line)
+{
+    pthread_mutex_lock(&nvc_lock);
+    nvc_add(&nvc_inflight, 1);
+    int enabled = nvc_totals.enabled;
+    nvmtl_census_row row = {0};
+    if (enabled) {
+        nvc_add(&nvc_totals.allocation_calls, 1);
+        row = nvc_request(device, info, function, line);
+    }
+    pthread_mutex_unlock(&nvc_lock);
+    VkResult result = pvkAllocateMemory(device, info, allocator, out);
+    pthread_mutex_lock(&nvc_lock);
+    nvc_sub(&nvc_inflight, 1);
+    if (enabled) {
+        nvc_add(&nvc_totals.sequence, 1);
+        if (result != VK_SUCCESS) {
+            /* A failed Vulkan allocation leaves *out undefined: never read it. */
+            nvc_add(&nvc_totals.allocation_failures, 1);
+            nvc_totals.last_failure_result = result;
+            nvc_totals.last_failure_request = row;
+        } else {
+            nvc_add(&nvc_totals.allocation_successes, 1);
+            row.memory = out ? (uintptr_t)*out : 0;
+            size_t slot = NVMTL_CENSUS_CAPACITY;
+            int duplicate = 0;
+            for (size_t i = 0; i < NVMTL_CENSUS_CAPACITY; ++i) {
+                if (nvc_rows[i].state == NVC_LIVE && nvc_rows[i].device == row.device && nvc_rows[i].memory == row.memory)
+                    duplicate = 1;
+                if (slot == NVMTL_CENSUS_CAPACITY && (nvc_rows[i].state == NVC_EMPTY || nvc_rows[i].state == NVC_RETIRED))
+                    slot = i;
+            }
+            if (!row.memory) nvc_flag(NVC_BAD_RESULT);
+            if (duplicate) { nvc_flag(NVC_DUPLICATE); nvc_add(&nvc_totals.duplicate_operations, 1); }
+            if (slot == NVMTL_CENSUS_CAPACITY) nvc_flag(NVC_CAPACITY);
+            if (nvc_generation == UINT64_MAX) nvc_flag(NVC_OVERFLOW);
+            if (!row.memory || duplicate || slot == NVMTL_CENSUS_CAPACITY || nvc_generation == UINT64_MAX) {
+                nvc_add(&nvc_totals.untracked_successes, 1);
+            } else {
+                row.generation = ++nvc_generation; row.allocation_sequence = nvc_totals.sequence;
+                row.state = NVC_LIVE; nvc_rows[slot] = row;
+                nvmtl_census_bucket *bucket = nvc_bucket(&row);
+                nvc_add(&bucket->allocated_bytes, row.size);
+                nvc_add(&bucket->live_bytes, row.size); nvc_add(&bucket->live_count, 1);
+                if (bucket->live_bytes > bucket->peak_live_bytes) bucket->peak_live_bytes = bucket->live_bytes;
+            }
+        }
+    }
+    pthread_mutex_unlock(&nvc_lock);
+    return result;
+}
+
+static void nvmtl_census_free(VkDevice device, VkDeviceMemory memory,
+                              const VkAllocationCallbacks *allocator, const char *function, uint32_t line)
+{
+    pthread_mutex_lock(&nvc_lock);
+    nvc_add(&nvc_inflight, 1);
+    int enabled = nvc_totals.enabled;
+    size_t slot = NVMTL_CENSUS_CAPACITY;
+    uint64_t generation = 0;
+    if (enabled) {
+        nvc_add(&nvc_totals.free_calls, 1); nvc_add(&nvc_totals.sequence, 1);
+        if (!memory) nvc_add(&nvc_totals.null_frees, 1);
+        else {
+            int seen = 0;
+            for (size_t i = 0; i < NVMTL_CENSUS_CAPACITY; ++i) {
+                if (nvc_rows[i].state != NVC_EMPTY && nvc_rows[i].device == (uintptr_t)device && nvc_rows[i].memory == (uintptr_t)memory) {
+                    seen = 1;
+                    if (nvc_rows[i].state == NVC_LIVE) { slot = i; break; }
+                }
+            }
+            if (slot == NVMTL_CENSUS_CAPACITY) {
+                if (seen) { nvc_flag(NVC_DUPLICATE); nvc_add(&nvc_totals.duplicate_operations, 1); }
+                else { nvc_flag(NVC_UNKNOWN_FREE); nvc_add(&nvc_totals.unknown_frees, 1); }
+            } else {
+                nvmtl_census_row *row = &nvc_rows[slot];
+                generation = row->generation; row->state = NVC_FREE_PENDING;
+                row->free_function = function; row->free_line = line;
+                nvmtl_census_bucket *bucket = nvc_bucket(row);
+                nvc_add(&bucket->pending_bytes, row->size); nvc_add(&bucket->pending_count, 1);
+            }
+        }
+    }
+    pthread_mutex_unlock(&nvc_lock);
+    pvkFreeMemory(device, memory, allocator);
+    pthread_mutex_lock(&nvc_lock);
+    nvc_sub(&nvc_inflight, 1);
+    if (enabled) {
+        nvc_add(&nvc_totals.sequence, 1);
+        if (slot != NVMTL_CENSUS_CAPACITY) {
+            nvmtl_census_row *row = &nvc_rows[slot];
+            if (row->generation != generation || row->state != NVC_FREE_PENDING ||
+                row->device != (uintptr_t)device || row->memory != (uintptr_t)memory) nvc_flag(NVC_METADATA);
+            else {
+                nvmtl_census_bucket *bucket = nvc_bucket(row);
+                nvc_sub(&bucket->pending_bytes, row->size); nvc_sub(&bucket->pending_count, 1);
+                nvc_sub(&bucket->live_bytes, row->size); nvc_sub(&bucket->live_count, 1);
+                nvc_add(&bucket->freed_api_bytes, row->size);
+                row->state = NVC_RETIRED;
+            }
+        }
+    }
+    pthread_mutex_unlock(&nvc_lock);
+}
diff --git a/plugin/nvmtl_headless.h b/plugin/nvmtl_headless.h
new file mode 100755
--- /dev/null
+++ b/plugin/nvmtl_headless.h
@@ -0,0 +1,19 @@
+#ifndef NVMTL_HEADLESS_H
+#define NVMTL_HEADLESS_H
+#include <stdbool.h>
+#include <CoreFoundation/CoreFoundation.h>
+#include <IOKit/IOKitLib.h>
+#include <string.h>
+static inline bool nvmtl_accelerator_is_headless(io_registry_entry_t entry) {
+    if (!entry) return false;
+    CFTypeRef value = IORegistryEntryCreateCFProperty(entry, CFSTR("NVAccelHeadless"),
+                                                    kCFAllocatorDefault, 0);
+    // Only the kernel's typed boolean enables this mode, never a string/number.
+    const bool headless = value == kCFBooleanTrue;
+    if (value) CFRelease(value);
+    return headless;
+}
+static inline bool nvmtl_headless_allows_process(bool headless, const char *process) {
+    return !headless || (process && process[0] && strcmp(process, "WindowServer") != 0);
+}
+#endif
diff --git a/plugin/nvmtl_registration_observation.h b/plugin/nvmtl_registration_observation.h
new file mode 100644
--- /dev/null
+++ b/plugin/nvmtl_registration_observation.h
@@ -0,0 +1,179 @@
+#ifndef NVMTL_REGISTRATION_OBSERVATION_H
+#define NVMTL_REGISTRATION_OBSERVATION_H
+#include <dlfcn.h>
+#include <errno.h>
+#include <execinfo.h>
+#include <inttypes.h>
+#include <mach-o/loader.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+/* Temporary diagnostic only. 24 * 256 + one 2048-byte stack <= 8192 bytes.
+ * No loader/VT query is made except one dladdr of the existing registrar to
+ * read its already-loaded LC_UUID. No new registration, waiting or retries. */
+static _Atomic int g_nvmtl_regobs_pid;
+static _Atomic unsigned g_nvmtl_regobs_events;
+static _Atomic int g_nvmtl_regobs_stack;
+static _Atomic uintptr_t g_nvmtl_regobs_symbol;
+static _Thread_local int g_nvmtl_regobs_busy;
+static _Atomic unsigned g_nvmtl_regobs_scopes;
+static _Atomic unsigned g_nvmtl_regobs_calls;
+static _Thread_local unsigned g_nvmtl_regobs_scope;
+static _Thread_local unsigned g_nvmtl_regobs_scope_call;
+static _Thread_local unsigned g_nvmtl_regobs_event_call;
+static _Thread_local int g_nvmtl_regobs_rc_valid;
+static _Thread_local int g_nvmtl_regobs_rc;
+
+static int nvmtl_regobs_enabled(void)
+{
+    int owner = atomic_load_explicit(&g_nvmtl_regobs_pid, memory_order_relaxed);
+    return owner && owner == getpid();
+}
+static unsigned nvmtl_regobs_reserve(void)
+{
+    unsigned n = atomic_load_explicit(&g_nvmtl_regobs_events, memory_order_relaxed);
+    for (unsigned tries = 0; tries < 8 && n < 24; tries++)
+        if (atomic_compare_exchange_weak_explicit(&g_nvmtl_regobs_events, &n, n + 1,
+                memory_order_relaxed, memory_order_relaxed)) return n + 1;
+    return 0; /* Drop on contention or exhaustion; never wait. */
+}
+static void nvmtl_regobs_event(const char *event, int state, int status)
+{
+    int saved_errno = errno;
+    if (nvmtl_regobs_enabled() && !g_nvmtl_regobs_busy) {
+        g_nvmtl_regobs_busy = 1;
+        unsigned seq = nvmtl_regobs_reserve();
+        if (seq) {
+            char line[256]; uint64_t tid = 0;
+            (void)pthread_threadid_np(NULL, &tid);
+            int n = snprintf(line, sizeof line,
+                "nvmtl-regobs v1 pid=%d tid=%" PRIu64 " ns=%" PRIu64 " seq=%u event=%s state=%d status=%d origin=%s scope=%u reg_call=%u vt_symbol=0x%" PRIxPTR "\n",
+                getpid(), tid, clock_gettime_nsec_np(CLOCK_MONOTONIC), seq,
+                event, state, status, g_nvmtl_regobs_scope ? "post_config" : "device_path",
+                g_nvmtl_regobs_scope, g_nvmtl_regobs_event_call, atomic_load_explicit(&g_nvmtl_regobs_symbol, memory_order_relaxed));
+            if (n > 0) (void)write(STDERR_FILENO, line,
+                (size_t)n < sizeof line ? (size_t)n : sizeof line - 1);
+        }
+        g_nvmtl_regobs_busy = 0;
+    }
+    errno = saved_errno;
+}
+static void nvmtl_regobs_begin(const char *canonical)
+{
+    int saved_errno = errno;
+    if (canonical && !strcmp(canonical, "/Applications/VideoProc Converter AI.app/Contents/Frameworks/ffmpeg")) {
+        int expected = 0;
+        if (atomic_compare_exchange_strong_explicit(&g_nvmtl_regobs_pid, &expected, getpid(),
+                memory_order_relaxed, memory_order_relaxed) || expected == getpid()) {
+            g_nvmtl_regobs_scope = atomic_fetch_add_explicit(&g_nvmtl_regobs_scopes, 1, memory_order_relaxed) + 1;
+            g_nvmtl_regobs_scope_call = 0;
+            g_nvmtl_regobs_rc_valid = 0;
+            g_nvmtl_regobs_rc = 0;
+            nvmtl_regobs_event("config_complete", 0, 0);
+            nvmtl_regobs_event("path_gate", 1, 0);
+        }
+    }
+    errno = saved_errno;
+}
+static void nvmtl_regobs_symbol(const void *symbol)
+{
+    int saved_errno = errno;
+    if (nvmtl_regobs_enabled()) {
+        atomic_store_explicit(&g_nvmtl_regobs_symbol, (uintptr_t)symbol, memory_order_relaxed);
+        nvmtl_regobs_event("vt_symbol", symbol != NULL, 0);
+    }
+    errno = saved_errno;
+}
+/* IDs describe actual calls, never entry/CAS/missing-symbol shortcuts. */
+static unsigned nvmtl_regobs_call(void)
+{
+    int saved_errno = errno;
+    unsigned call = 0;
+    if (nvmtl_regobs_enabled()) {
+        call = atomic_fetch_add_explicit(&g_nvmtl_regobs_calls, 1, memory_order_relaxed) + 1;
+        if (g_nvmtl_regobs_scope) {
+            g_nvmtl_regobs_scope_call = call;
+            g_nvmtl_regobs_rc_valid = 0;
+        }
+    }
+    errno = saved_errno;
+    return call;
+}
+static void nvmtl_regobs_result(unsigned call, int status)
+{
+    int saved_errno = errno;
+    if (nvmtl_regobs_enabled() && call) {
+        if (g_nvmtl_regobs_scope && g_nvmtl_regobs_scope_call == call) {
+            g_nvmtl_regobs_rc = status;
+            g_nvmtl_regobs_rc_valid = 1;
+        }
+        g_nvmtl_regobs_event_call = call;
+        nvmtl_regobs_event("register_result", status ? 0 : 2, status);
+        g_nvmtl_regobs_event_call = 0;
+    }
+    errno = saved_errno;
+}
+static void nvmtl_regobs_uuid(const void *symbol, char uuid[33])
+{
+    memcpy(uuid, "unknown", 8);
+    Dl_info image;
+    if (!symbol || !dladdr(symbol, &image) || !image.dli_fbase) return;
+    const struct mach_header_64 *header = image.dli_fbase;
+    if (header->magic != MH_MAGIC_64 || header->ncmds > 128 || header->sizeofcmds > 65536) return;
+    const unsigned char *cursor = (const unsigned char *)(header + 1);
+    size_t remaining = header->sizeofcmds;
+    for (uint32_t i = 0; i < header->ncmds; i++) {
+        if (remaining < sizeof(struct load_command)) return;
+        const struct load_command *command = (const void *)cursor;
+        if (command->cmdsize < sizeof *command || command->cmdsize > remaining) return;
+        if (command->cmd == LC_UUID) {
+            if (command->cmdsize < sizeof(struct uuid_command)) return;
+            const struct uuid_command *value = (const void *)command;
+            for (unsigned j = 0; j < 16; j++) snprintf(uuid + 2*j, 3, "%02x", value->uuid[j]);
+            return;
+        }
+        cursor += command->cmdsize; remaining -= command->cmdsize;
+    }
+}
+static void nvmtl_regobs_finish(void)
+{
+    int saved_errno = errno;
+    int end_scope = nvmtl_regobs_enabled() && !g_nvmtl_regobs_busy;
+    if (end_scope && !atomic_exchange_explicit(&g_nvmtl_regobs_stack, 1, memory_order_relaxed)) {
+        g_nvmtl_regobs_busy = 1;
+        char line[2048], uuid[33]; void *pcs[64]; uint64_t tid = 0;
+        uintptr_t symbol = atomic_load_explicit(&g_nvmtl_regobs_symbol, memory_order_relaxed);
+        nvmtl_regobs_uuid((const void *)symbol, uuid);
+        int frames = backtrace(pcs, 64);
+        if (frames < 0) frames = 0;
+        if (frames > 64) frames = 64;
+        (void)pthread_threadid_np(NULL, &tid);
+        int n = snprintf(line, sizeof line,
+            "nvmtl-regobs v1 pid=%d tid=%" PRIu64 " ns=%" PRIu64 " event=stack origin=post_config scope=%u reg_call=%u rc_valid=%d rc=%d vt_symbol=0x%" PRIxPTR " vt_uuid=%s frames=%d pc=",
+            getpid(), tid, clock_gettime_nsec_np(CLOCK_MONOTONIC),
+            g_nvmtl_regobs_scope, g_nvmtl_regobs_scope_call, g_nvmtl_regobs_rc_valid,
+            g_nvmtl_regobs_rc, symbol, uuid, frames);
+        size_t used = n > 0 && (size_t)n < sizeof line ? (size_t)n : 0;
+        for (int i = 0; used && i < frames && used + 20 < sizeof line; i++) {
+            n = snprintf(line + used, sizeof line - used, "%s0x%" PRIxPTR, i ? "," : "", (uintptr_t)pcs[i]);
+            if (n <= 0 || (size_t)n >= sizeof line - used) { used = 0; break; }
+            used += (size_t)n;
+        }
+        if (used && used + 1 < sizeof line) { line[used++] = '\n'; (void)write(STDERR_FILENO, line, used); }
+        g_nvmtl_regobs_busy = 0;
+    }
+    /* A reentrant dropped finish must not clear its outer scope. */
+    if (end_scope) {
+        g_nvmtl_regobs_scope = 0;
+        g_nvmtl_regobs_scope_call = 0;
+        g_nvmtl_regobs_rc_valid = 0;
+        g_nvmtl_regobs_rc = 0;
+    }
+    errno = saved_errno;
+}
+#endif
