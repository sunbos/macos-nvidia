+// Keep small metadata independent of substrings that may share an entire IR backing store.
+static NSString *nvmtl_cold_metadata_string(NSString *value) {
+    const char *bytes = value.UTF8String;
+    if (!bytes) return [value copy];
+    return [[NSString alloc] initWithBytes:bytes length:[value lengthOfBytesUsingEncoding:NSUTF8StringEncoding]
+                                 encoding:NSUTF8StringEncoding] ?: [value copy];
+}
+static NSArray<NSString *> *nvmtl_cold_metadata_names(NSArray<NSString *> *names) {
+    NSMutableArray *owned = [NSMutableArray arrayWithCapacity:names.count];
+    for (NSString *name in names) [owned addObject:nvmtl_cold_metadata_string(name)];
+    return [owned copy];
+}
+static NSNumber *nvmtl_cold_blob(NSData *air, NSString *ll, NSMutableArray *blobs, NSMutableArray *symbols) {
+    NSMutableSet *declared = [NSMutableSet new], *defined = [NSMutableSet new];
+    [ll enumerateLinesUsingBlock:^(NSString *line, BOOL *stop) {
+        @autoreleasepool {
+            BOOL isDecl = [line hasPrefix:@"declare"];
+            if (!isDecl && ![line hasPrefix:@"define"]) return;
+            NSString *sym = nvmtl_sym_at(line);
+            if (!sym.length || [sym hasPrefix:@"air."] || [sym hasPrefix:@"llvm."]) return;
+            [(isDecl ? declared : defined) addObject:nvmtl_cold_metadata_string(sym)];
+        }
+    }];
+    NSNumber *slot = @(blobs.count);
+    [blobs addObject:air];
+    [symbols addObject:@[[declared copy], [defined copy]]];
+    return slot;
+}
